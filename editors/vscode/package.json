{
  "name": "lilysharp",
  "displayName": "Lily#",
  "description": "Sheet music from plain text — LilyPond-derived engraving, live as you type.",
  "version": "0.5.0",
  "publisher": "yotsuda",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yotsuda/LilySharp.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "music",
    "notation",
    "sheet music",
    "lilypond",
    "score",
    "engraving"
  ],
  "activationEvents": [
    "onLanguage:lilysharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lilysharp",
        "aliases": [
          "Lily#",
          "lilysharp"
        ],
        "extensions": [
          ".lys"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lilysharp",
        "scopeName": "source.lilysharp",
        "path": "./syntaxes/lilysharp.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "pitch",
        "superType": "variable",
        "description": "Note pitches (c, d, e, f, g, a, b)"
      },
      {
        "id": "articulation",
        "superType": "decorator",
        "description": "Articulation marks (@staccato, @accent)"
      },
      {
        "id": "dynamic",
        "superType": "modifier",
        "description": "Dynamic marks (@p, @f)"
      },
      {
        "id": "section",
        "superType": "class",
        "description": "Section names"
      },
      {
        "id": "phrase",
        "superType": "function",
        "description": "Phrase names"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "pitch": [
            "variable.other.pitch.lilysharp"
          ],
          "articulation": [
            "entity.name.function.articulation.lilysharp"
          ],
          "dynamic": [
            "keyword.control.dynamic.lilysharp"
          ],
          "section": [
            "entity.name.section.lilysharp"
          ],
          "phrase": [
            "entity.name.function.phrase.lilysharp"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "[*]": {
          "rules": {
            "pitch": "#4EC9B0",
            "articulation": "#DCDCAA",
            "dynamic": "#C586C0",
            "part": "#4FC1FF",
            "section": "#FFA657",
            "phrase": "#D2A8FF"
          }
        }
      },
      "[lilysharp]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.wordBasedSuggestions": "off",
        "editor.inlineSuggest.enabled": false
      }
    },
    "configuration": {
      "title": "Lily#",
      "properties": {
        "lilysharp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Lily# language server executable"
        },
        "lilysharp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "lilysharp.preview.autoRefresh": {
          "default": true,
          "description": "Automatically refresh preview on document change",
          "type": "boolean"
        },
        "lilysharp.preview.refreshDelay": {
          "minimum": 100,
          "maximum": 2000,
          "default": 100,
          "description": "Delay in milliseconds before refreshing preview after document change",
          "type": "number"
        },
        "lilysharp.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumItemLabels": [
            "Follow VS Code's color theme",
            "Light",
            "Dark"
          ],
          "enumDescriptions": [
            "The preview is light under a light VS Code theme and dark under a dark one (the default).",
            "Always the printed page: black notes on white, whatever the editor theme.",
            "Always dark: the page inverted to white notes on a dark ground."
          ],
          "default": "auto",
          "description": "The score preview's color scheme. Takes effect immediately in open previews."
        },
        "lilysharp.completion.flatSpelling": {
          "type": "string",
          "enum": [
            "full",
            "contracted"
          ],
          "enumItemLabels": [
            "ees / aes",
            "es / as"
          ],
          "default": "full",
          "description": "How flat pitches (E♭, A♭) are spelled in the autocomplete list. Both spellings always compile; this only changes which the completer suggests."
        },
        "lilysharp.import.relativeOctave": {
          "type": "boolean",
          "default": false,
          "description": "When importing MusicXML, emit compact relative-octave notes (c d e) instead of explicit absolute octaves (c' d' e'). Both render identically."
        },
        "lilysharp.ai.ghostCompletion": {
          "type": "boolean",
          "default": false,
          "description": "Suggest the next measure as ghost text while you type (just after a barline), using your language model (GitHub Copilot). Each suggestion is compiled first and only shown if it is valid. Off by default because it calls the model as you type."
        }
      }
    },
    "commands": [
      {
        "command": "lilysharp.openPreview",
        "category": "Lily#",
        "icon": "$(open-preview)",
        "title": "Open Preview"
      },
      {
        "command": "lilysharp.openPreviewToSide",
        "category": "Lily#",
        "icon": "$(open-preview)",
        "title": "Open Preview to Side"
      },
      {
        "command": "lilysharp.convertLayout",
        "category": "Lily#",
        "title": "Convert Layout (part-major ⇄ section-major)"
      },
      {
        "command": "lilysharp.extractPhrase",
        "category": "Lily#",
        "title": "Extract Phrase from Section"
      },
      {
        "command": "lilysharp.addChordTrack",
        "category": "Lily#",
        "title": "Add Chord Track (auto-harmonize)"
      },
      {
        "command": "lilysharp.newScore",
        "category": "Lily#",
        "icon": "$(new-file)",
        "title": "New Score",
        "shortTitle": "Lily# Score (.lys)"
      },
      {
        "command": "lilysharp.importMusicXml",
        "category": "Lily#",
        "title": "Import MusicXML…"
      },
      {
        "command": "lilysharp.aiTransform",
        "category": "Lily#",
        "icon": "$(sparkle)",
        "title": "Transform Selection with AI…"
      },
      {
        "command": "lilysharp.playNoteAtCursor",
        "category": "Lily#",
        "title": "Play Note at Cursor (hold)"
      },
      {
        "command": "lilysharp.playMeasureAtCursor",
        "category": "Lily#",
        "title": "Play Current Measure"
      },
      {
        "command": "lilysharp.previewPlayFromHere",
        "category": "Lily#",
        "title": "Play from Here"
      },
      {
        "command": "lilysharp.previewStop",
        "category": "Lily#",
        "title": "Stop Playback"
      },
      {
        "command": "lilysharp.previewFitWidth",
        "category": "Lily#",
        "title": "Fit Width"
      },
      {
        "command": "lilysharp.previewResetZoom",
        "category": "Lily#",
        "title": "Reset Zoom (100%)"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "lilysharp.newScore",
          "group": "file"
        }
      ],
      "commandPalette": [
        {
          "command": "lilysharp.newScore"
        },
        {
          "command": "lilysharp.openPreview",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.openPreviewToSide",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.convertLayout",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.extractPhrase",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.addChordTrack",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.importMusicXml"
        },
        {
          "command": "lilysharp.aiTransform",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.playNoteAtCursor",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.playMeasureAtCursor",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.previewPlayFromHere",
          "when": "activeWebviewPanelId == 'lilysharpPreview'"
        },
        {
          "command": "lilysharp.previewStop",
          "when": "activeWebviewPanelId == 'lilysharpPreview'"
        },
        {
          "command": "lilysharp.previewFitWidth",
          "when": "activeWebviewPanelId == 'lilysharpPreview'"
        },
        {
          "command": "lilysharp.previewResetZoom",
          "when": "activeWebviewPanelId == 'lilysharpPreview'"
        }
      ],
      "webview/context": [
        {
          "command": "lilysharp.previewPlayFromHere",
          "when": "webviewId == 'lilysharpPreview' && lysNote",
          "group": "1_playback@1"
        },
        {
          "command": "lilysharp.previewStop",
          "when": "webviewId == 'lilysharpPreview' && lysPlaying",
          "group": "1_playback@2"
        },
        {
          "command": "lilysharp.previewFitWidth",
          "when": "webviewId == 'lilysharpPreview'",
          "group": "2_zoom@1"
        },
        {
          "command": "lilysharp.previewResetZoom",
          "when": "webviewId == 'lilysharpPreview'",
          "group": "2_zoom@2"
        }
      ],
      "explorer/context": [
        {
          "command": "lilysharp.importMusicXml",
          "when": "resourceExtname == .xml || resourceExtname == .musicxml || resourceExtname == .mxl",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "lilysharp.aiTransform",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@1"
        },
        {
          "command": "lilysharp.convertLayout",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@2"
        },
        {
          "command": "lilysharp.extractPhrase",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@3"
        },
        {
          "command": "lilysharp.addChordTrack",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@3"
        }
      ],
      "editor/title": [
        {
          "command": "lilysharp.openPreviewToSide",
          "when": "resourceLangId == lilysharp",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lilysharp.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == lilysharp"
      },
      {
        "command": "lilysharp.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceLangId == lilysharp"
      },
      {
        "command": "lilysharp.aiTransform",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.playNoteAtCursor",
        "key": "alt+p",
        "when": "editorTextFocus && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.playMeasureAtCursor",
        "key": "alt+m",
        "when": "editorTextFocus && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "'",
        "args": { "text": "'" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": ",",
        "args": { "text": "," },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": ".",
        "args": { "text": "." },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "\\",
        "args": { "text": "\\" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "0",
        "args": { "text": "0" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "1",
        "args": { "text": "1" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "2",
        "args": { "text": "2" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "3",
        "args": { "text": "3" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "4",
        "args": { "text": "4" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "5",
        "args": { "text": "5" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "6",
        "args": { "text": "6" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "7",
        "args": { "text": "7" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "8",
        "args": { "text": "8" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "9",
        "args": { "text": "9" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "compile": "node esbuild.js",
    "check-types": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/test/**/*.test.js\"",
    "bench": "tsc -p tsconfig.test.json && node out-test/test/bench.js",
    "watch": "node esbuild.js --watch",
    "deploy-server": "pwsh -Command \"dotnet publish ../../LilySharp.Lsp -c Release -r win-x64 --self-contained true -o ./server\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "icon.png"
}
