{
  "name": "lilysharp",
  "displayName": "Lily#",
  "description": "Language support for Lily# music notation",
  "version": "0.1.2-dev.95",
  "publisher": "lilysharp",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lilysharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lilysharp",
        "aliases": [
          "Lily#",
          "lilysharp"
        ],
        "extensions": [
          ".lys"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lilysharp",
        "scopeName": "source.lilysharp",
        "path": "./syntaxes/lilysharp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lilysharp",
        "path": "./snippets/lilysharp.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "pitch",
        "superType": "variable",
        "description": "Note pitches (c, d, e, f, g, a, b)"
      },
      {
        "id": "articulation",
        "superType": "decorator",
        "description": "Articulation marks (@staccato, @accent)"
      },
      {
        "id": "dynamic",
        "superType": "modifier",
        "description": "Dynamic marks (@p, @f)"
      },
      {
        "id": "section",
        "superType": "class",
        "description": "Section names"
      },
      {
        "id": "phrase",
        "superType": "function",
        "description": "Phrase names"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "pitch": [
            "variable.other.pitch.lilysharp"
          ],
          "articulation": [
            "entity.name.function.articulation.lilysharp"
          ],
          "dynamic": [
            "keyword.control.dynamic.lilysharp"
          ],
          "section": [
            "entity.name.section.lilysharp"
          ],
          "phrase": [
            "entity.name.function.phrase.lilysharp"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "[*]": {
          "rules": {
            "pitch": "#4EC9B0",
            "articulation": "#DCDCAA",
            "dynamic": "#C586C0",
            "section": "#4FC1FF",
            "phrase": "#DCDCAA"
          }
        }
      }
    },
    "configuration": {
      "title": "Lily#",
      "properties": {
        "lilysharp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Lily# language server executable"
        },
        "lilysharp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "lilysharp.preview.autoRefresh": {
          "default": true,
          "description": "Automatically refresh preview on document change",
          "type": "boolean"
        },
        "lilysharp.preview.refreshDelay": {
          "minimum": 100,
          "maximum": 2000,
          "default": 300,
          "description": "Delay in milliseconds before refreshing preview after document change",
          "type": "number"
        }
      }
    },
    "commands": [
      {
        "command": "lilysharp.openPreview",
        "category": "Lily#",
        "icon": "$(open-preview)",
        "title": "Open Preview"
      },
      {
        "command": "lilysharp.openPreviewToSide",
        "category": "Lily#",
        "icon": "$(open-preview)",
        "title": "Open Preview to Side"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "lilysharp.openPreview",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.openPreviewToSide",
          "when": "resourceLangId == lilysharp"
        }
      ],
      "editor/title": [
        {
          "command": "lilysharp.openPreviewToSide",
          "when": "resourceLangId == lilysharp",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lilysharp.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == lilysharp"
      },
      {
        "command": "lilysharp.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceLangId == lilysharp"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run deploy-server",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "deploy-server": "pwsh -Command \"dotnet publish ../../LilySharp.Lsp -c Release -o ./server\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "icon.png"
}
