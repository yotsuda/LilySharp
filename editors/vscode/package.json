{
  "name": "lilysharp",
  "displayName": "Lily#",
  "description": "Language support and live score preview for Lily#, a LilyPond-inspired music notation language",
  "version": "0.3.0-dev.8",
  "publisher": "ytsuda",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yotsuda/LilySharp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "music",
    "notation",
    "sheet music",
    "lilypond",
    "score",
    "engraving"
  ],
  "activationEvents": [
    "onLanguage:lilysharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lilysharp",
        "aliases": [
          "Lily#",
          "lilysharp"
        ],
        "extensions": [
          ".lys"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lilysharp",
        "scopeName": "source.lilysharp",
        "path": "./syntaxes/lilysharp.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "pitch",
        "superType": "variable",
        "description": "Note pitches (c, d, e, f, g, a, b)"
      },
      {
        "id": "articulation",
        "superType": "decorator",
        "description": "Articulation marks (@staccato, @accent)"
      },
      {
        "id": "dynamic",
        "superType": "modifier",
        "description": "Dynamic marks (@p, @f)"
      },
      {
        "id": "section",
        "superType": "class",
        "description": "Section names"
      },
      {
        "id": "phrase",
        "superType": "function",
        "description": "Phrase names"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "pitch": [
            "variable.other.pitch.lilysharp"
          ],
          "articulation": [
            "entity.name.function.articulation.lilysharp"
          ],
          "dynamic": [
            "keyword.control.dynamic.lilysharp"
          ],
          "section": [
            "entity.name.section.lilysharp"
          ],
          "phrase": [
            "entity.name.function.phrase.lilysharp"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "[*]": {
          "rules": {
            "pitch": "#4EC9B0",
            "articulation": "#DCDCAA",
            "dynamic": "#C586C0",
            "section": "#4FC1FF",
            "phrase": "#DCDCAA"
          }
        }
      }
    },
    "configuration": {
      "title": "Lily#",
      "properties": {
        "lilysharp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Lily# language server executable"
        },
        "lilysharp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "lilysharp.preview.autoRefresh": {
          "default": true,
          "description": "Automatically refresh preview on document change",
          "type": "boolean"
        },
        "lilysharp.preview.refreshDelay": {
          "minimum": 100,
          "maximum": 2000,
          "default": 100,
          "description": "Delay in milliseconds before refreshing preview after document change",
          "type": "number"
        },
        "lilysharp.completion.flatSpelling": {
          "type": "string",
          "enum": [
            "full",
            "contracted"
          ],
          "enumItemLabels": [
            "ees / aes",
            "es / as"
          ],
          "default": "full",
          "description": "How flat pitches (E♭, A♭) are spelled in the autocomplete list. Both spellings always compile; this only changes which the completer suggests."
        }
      }
    },
    "commands": [
      {
        "command": "lilysharp.openPreview",
        "category": "Lily#",
        "icon": "$(open-preview)",
        "title": "Open Preview"
      },
      {
        "command": "lilysharp.openPreviewToSide",
        "category": "Lily#",
        "icon": "$(open-preview)",
        "title": "Open Preview to Side"
      },
      {
        "command": "lilysharp.convertLayout",
        "category": "Lily#",
        "title": "Convert Layout (part-major ⇄ section-major)"
      },
      {
        "command": "lilysharp.addChordTrack",
        "category": "Lily#",
        "title": "Add Chord Track (auto-harmonize)"
      },
      {
        "command": "lilysharp.newScore",
        "category": "Lily#",
        "icon": "$(new-file)",
        "title": "New Score",
        "shortTitle": "Lily# Score (.lys)"
      },
      {
        "command": "lilysharp.importMusicXml",
        "category": "Lily#",
        "title": "Import MusicXML…"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "lilysharp.newScore",
          "group": "file"
        }
      ],
      "commandPalette": [
        {
          "command": "lilysharp.newScore"
        },
        {
          "command": "lilysharp.openPreview",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.openPreviewToSide",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.convertLayout",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.addChordTrack",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.importMusicXml"
        }
      ],
      "explorer/context": [
        {
          "command": "lilysharp.importMusicXml",
          "when": "resourceExtname == .xml || resourceExtname == .musicxml || resourceExtname == .mxl",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "lilysharp.convertLayout",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification"
        },
        {
          "command": "lilysharp.addChordTrack",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "lilysharp.openPreviewToSide",
          "when": "resourceLangId == lilysharp",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lilysharp.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == lilysharp"
      },
      {
        "command": "lilysharp.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceLangId == lilysharp"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "compile": "node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "node esbuild.js --watch",
    "deploy-server": "pwsh -Command \"dotnet publish ../../LilySharp.Lsp -c Release -r win-x64 --self-contained true -o ./server\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "icon.png"
}
