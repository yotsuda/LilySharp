{
  "name": "lilysharp",
  "displayName": "Lily#",
  "description": "Sheet music from plain text — LilyPond-derived engraving, live as you type.",
  "version": "0.9.0",
  "publisher": "yotsuda",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yotsuda/LilySharp.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "music",
    "notation",
    "sheet music",
    "lilypond",
    "score",
    "engraving"
  ],
  "activationEvents": [
    "onLanguage:lilysharp",
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatInstructions": [
      {
        "path": "./out/lilysharp.instructions.md"
      }
    ],
    "languages": [
      {
        "id": "lilysharp",
        "aliases": [
          "Lily#",
          "lilysharp"
        ],
        "extensions": [
          ".lys"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lilysharp",
        "scopeName": "source.lilysharp",
        "path": "./syntaxes/lilysharp.tmLanguage.json"
      },
      {
        "scopeName": "markdown.lilysharp.codeblock",
        "path": "./syntaxes/lilysharp.markdown.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.lilysharp": "lilysharp"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/markdown-lys.css"
    ],
    "semanticTokenTypes": [
      {
        "id": "pitch",
        "superType": "variable",
        "description": "Note pitches (c, d, e, f, g, a, b)"
      },
      {
        "id": "articulation",
        "superType": "decorator",
        "description": "Articulation marks (@staccato, @accent)"
      },
      {
        "id": "dynamic",
        "superType": "modifier",
        "description": "Dynamic marks (@p, @f)"
      },
      {
        "id": "section",
        "superType": "class",
        "description": "Section names"
      },
      {
        "id": "phrase",
        "superType": "function",
        "description": "Phrase names"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "pitch": [
            "variable.other.pitch.lilysharp"
          ],
          "articulation": [
            "entity.name.function.articulation.lilysharp"
          ],
          "dynamic": [
            "keyword.control.dynamic.lilysharp"
          ],
          "section": [
            "entity.name.section.lilysharp"
          ],
          "phrase": [
            "entity.name.function.phrase.lilysharp"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "[*]": {
          "rules": {
            "pitch": "#4EC9B0",
            "articulation": "#DCDCAA",
            "dynamic": "#C586C0",
            "part": "#4FC1FF",
            "section": "#FFA657",
            "phrase": "#D2A8FF"
          }
        }
      },
      "[lilysharp]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.wordBasedSuggestions": "off",
        "editor.inlineSuggest.enabled": false
      }
    },
    "configuration": {
      "title": "Lily#",
      "properties": {
        "lilysharp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Lily# language server executable"
        },
        "lilysharp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "lilysharp.preview.autoRefresh": {
          "default": true,
          "description": "Automatically refresh preview on document change",
          "type": "boolean"
        },
        "lilysharp.preview.refreshDelay": {
          "minimum": 100,
          "maximum": 2000,
          "default": 100,
          "description": "Delay in milliseconds before refreshing preview after document change",
          "type": "number"
        },
        "lilysharp.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumItemLabels": [
            "Follow VS Code's color theme",
            "Light",
            "Dark"
          ],
          "enumDescriptions": [
            "The preview is light under a light VS Code theme and dark under a dark one (the default).",
            "Always the printed page: black notes on white, whatever the editor theme.",
            "Always dark: the page inverted to white notes on a dark ground."
          ],
          "default": "auto",
          "description": "The score preview's color scheme. Takes effect immediately in open previews."
        },
        "lilysharp.preview.highlightTodos": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Draw the notes, chords and rests marked `@todo` in red in the preview. Printing (`lysc png` / `pdf` / `svg`) never does. Takes effect immediately in open previews."
        },
        "lilysharp.audition.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Sound notes as you edit: the note the caret lands on, a note as you type it, and what Ctrl+Shift+Up / Ctrl+Shift+Down step a note or a chord shape to. Plays through the open preview, so nothing sounds while no preview is open. Play Note at Cursor (Alt+P) and Play Current Measure (Alt+M) are not affected."
        },
        "lilysharp.typingAids.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Typing aids in `.lys` music: an octave mark, a duration digit, a dot, a string number (`\\`) or an annotation (`@`) typed anywhere on a note moves into its slot on that note; a digit always leaves a valid duration (`c1` + `2` → `c2`, `c4` + `6` → `c64`; 5, 7, 9 and 0 leave the note unchanged); `<` `>` `(` `)` `[` `]` `~` keep chords, slurs, beams and ties paired and on their notes. Off: every key is typed exactly as pressed. Ctrl+Shift+Up / Ctrl+Shift+Down are not affected."
        },
        "lilysharp.chordShapes.includeStretch": {
          "type": "boolean",
          "default": false,
          "description": "Let Ctrl+Shift+Up / Ctrl+Shift+Down on a chord (an @chord(...) or a chords-row entry) also step through stretch shapes: shapes whose fretted frets lie five frets apart (lowest to highest), which are hard to play. Off by default, so the step offers only shapes within four frets. The first shape a step writes is not affected: for a chord LilyPond's table lacks it is a shape without a stretch whenever there is one."
        },
        "lilysharp.completion.flatSpelling": {
          "type": "string",
          "enum": [
            "full",
            "contracted"
          ],
          "enumItemLabels": [
            "ees / aes",
            "es / as"
          ],
          "default": "full",
          "description": "How flat pitches (E♭, A♭) are spelled in the autocomplete list. Both spellings always compile; this only changes which the completer suggests."
        },
        "lilysharp.import.relativeOctave": {
          "type": "boolean",
          "default": false,
          "description": "When importing MusicXML, emit compact relative-octave notes (c d e) instead of explicit absolute octaves (c' d' e'). Both render identically."
        },
        "lilysharp.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "The language model *Transform Selection with AI* uses: a model id or family from **Lily#: Select AI Model…**. Empty chooses automatically — the largest model on offer, passing over the small ones (mini, nano, lite, …), which write poor Lily#. Ghost Completion has its own: `#lilysharp.ai.ghostModel#`."
        },
        "lilysharp.ai.ghostModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "The language model Ghost Completion uses: a model id or family from **Lily#: Select AI Model…**. It answers as you type, and VS Code drops a suggestion the moment the caret moves, so it needs a FAST model — a large one is cancelled before it shows. Empty chooses automatically: a small model (mini, nano, lite, …)."
        },
        "lilysharp.ai.ghostCompletion": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Suggest the next measure as ghost text while you type (just after a barline), using your language model (GitHub Copilot). Each suggestion is compiled first and only shown if it is valid. Off by default because it calls the model as you type.\n\nIt is an inline suggestion, and Lily# turns inline suggestions off in `.lys` files by default (`editor.inlineSuggest.enabled`), because GitHub Copilot's own completion slowed every keystroke there. When you switch this on, Lily# offers to turn inline suggestions on for `.lys` files and to keep Copilot's completions off there (`github.copilot.enable`)."
        }
      }
    },
    "commands": [
      {
        "command": "lilysharp.openPreview",
        "category": "Lily#",
        "icon": "$(open-preview)",
        "title": "Open Preview"
      },
      {
        "command": "lilysharp.openPreviewToSide",
        "category": "Lily#",
        "icon": "$(open-preview)",
        "title": "Open Preview to Side"
      },
      {
        "command": "lilysharp.regroup",
        "category": "Lily#",
        "title": "Regroup (by part ⇄ by section)"
      },
      {
        "command": "lilysharp.splitSectionsToMatch",
        "category": "Lily#",
        "title": "Split Sections to Match a Part"
      },
      {
        "command": "lilysharp.convertOctavesToAbsolute",
        "category": "Lily#",
        "title": "Convert Octaves to Absolute"
      },
      {
        "command": "lilysharp.convertOctavesToRelative",
        "category": "Lily#",
        "title": "Convert Octaves to Relative"
      },
      {
        "command": "lilysharp.extractPhrase",
        "category": "Lily#",
        "title": "Extract Phrase from Section"
      },
      {
        "command": "lilysharp.addChordTrack",
        "category": "Lily#",
        "title": "Add Chord Track (auto-harmonize)"
      },
      {
        "command": "lilysharp.newScore",
        "category": "Lily#",
        "icon": "$(new-file)",
        "title": "New Score",
        "shortTitle": "Lily# Score (.lys)"
      },
      {
        "command": "lilysharp.importMusicXml",
        "category": "Lily#",
        "title": "Import MusicXML…"
      },
      {
        "command": "lilysharp.importImage",
        "category": "Lily#",
        "title": "Import from Image/PDF…"
      },
      {
        "command": "lilysharp.aiTransform",
        "category": "Lily#",
        "icon": "$(sparkle)",
        "title": "Transform Selection with AI…"
      },
      {
        "command": "lilysharp.selectAiModel",
        "category": "Lily#",
        "title": "Select AI Model…"
      },
      {
        "command": "lilysharp.playNoteAtCursor",
        "category": "Lily#",
        "title": "Play Note at Cursor (hold)"
      },
      {
        "command": "lilysharp.playMeasureAtCursor",
        "category": "Lily#",
        "title": "Play Current Measure"
      },
      {
        "command": "lilysharp.stepUp",
        "category": "Lily#",
        "title": "Step Up (octave mark / chord shape)"
      },
      {
        "command": "lilysharp.stepDown",
        "category": "Lily#",
        "title": "Step Down (octave mark / chord shape)"
      },
      {
        "command": "lilysharp.previewPlayFromHere",
        "category": "Lily#",
        "title": "Play from Here"
      },
      {
        "command": "lilysharp.previewStop",
        "category": "Lily#",
        "title": "Stop Playback"
      },
      {
        "command": "lilysharp.previewFitWidth",
        "category": "Lily#",
        "title": "Fit Width"
      },
      {
        "command": "lilysharp.previewResetZoom",
        "category": "Lily#",
        "title": "Reset Zoom (100%)"
      },
      {
        "command": "lilysharp.exportPdf",
        "category": "Lily#",
        "title": "Export as PDF"
      },
      {
        "command": "lilysharp.exportSvg",
        "category": "Lily#",
        "title": "Export as SVG"
      },
      {
        "command": "lilysharp.exportPng",
        "category": "Lily#",
        "title": "Export as PNG"
      },
      {
        "command": "lilysharp.exportLy",
        "category": "Lily#",
        "title": "Export as LilyPond (.ly)"
      },
      {
        "command": "lilysharp.exportMusicXml",
        "category": "Lily#",
        "title": "Export as MusicXML"
      },
      {
        "command": "lilysharp.exportMidi",
        "category": "Lily#",
        "title": "Export as MIDI"
      },
      {
        "command": "lilysharp.exportVsqx",
        "category": "Lily#",
        "title": "Export as VOCALOID sequence (.vsqx)"
      }
    ],
    "submenus": [
      {
        "id": "lilysharp.export",
        "label": "Lily#: Export"
      }
    ],
    "menus": {
      "lilysharp.export": [
        {
          "command": "lilysharp.exportPdf",
          "group": "1_page@1"
        },
        {
          "command": "lilysharp.exportSvg",
          "group": "1_page@2"
        },
        {
          "command": "lilysharp.exportPng",
          "group": "1_page@3"
        },
        {
          "command": "lilysharp.exportLy",
          "group": "2_source@1"
        },
        {
          "command": "lilysharp.exportMusicXml",
          "group": "2_source@2"
        },
        {
          "command": "lilysharp.exportMidi",
          "group": "3_sound@1"
        },
        {
          "command": "lilysharp.exportVsqx",
          "group": "3_sound@2"
        }
      ],
      "file/newFile": [
        {
          "command": "lilysharp.newScore",
          "group": "file"
        }
      ],
      "commandPalette": [
        {
          "command": "lilysharp.newScore"
        },
        {
          "command": "lilysharp.openPreview",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.openPreviewToSide",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.regroup",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.splitSectionsToMatch",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.convertOctavesToAbsolute",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.convertOctavesToRelative",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.extractPhrase",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.addChordTrack",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.importMusicXml"
        },
        {
          "command": "lilysharp.importImage",
          "when": "lilysharp.omrAvailable"
        },
        {
          "command": "lilysharp.aiTransform",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.playNoteAtCursor",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.playMeasureAtCursor",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.stepUp",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.stepDown",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.previewPlayFromHere",
          "when": "activeWebviewPanelId == 'lilysharpPreview'"
        },
        {
          "command": "lilysharp.previewStop",
          "when": "activeWebviewPanelId == 'lilysharpPreview'"
        },
        {
          "command": "lilysharp.previewFitWidth",
          "when": "activeWebviewPanelId == 'lilysharpPreview'"
        },
        {
          "command": "lilysharp.previewResetZoom",
          "when": "activeWebviewPanelId == 'lilysharpPreview'"
        },
        {
          "command": "lilysharp.exportPdf",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.exportSvg",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.exportPng",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.exportLy",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.exportMusicXml",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.exportMidi",
          "when": "resourceLangId == lilysharp"
        },
        {
          "command": "lilysharp.exportVsqx",
          "when": "resourceLangId == lilysharp"
        }
      ],
      "webview/context": [
        {
          "command": "lilysharp.previewPlayFromHere",
          "when": "webviewId == 'lilysharpPreview' && lysNote",
          "group": "1_playback@1"
        },
        {
          "command": "lilysharp.previewStop",
          "when": "webviewId == 'lilysharpPreview' && lysPlaying",
          "group": "1_playback@2"
        },
        {
          "command": "lilysharp.previewFitWidth",
          "when": "webviewId == 'lilysharpPreview'",
          "group": "2_zoom@1"
        },
        {
          "command": "lilysharp.previewResetZoom",
          "when": "webviewId == 'lilysharpPreview'",
          "group": "2_zoom@2"
        }
      ],
      "explorer/context": [
        {
          "command": "lilysharp.importMusicXml",
          "when": "resourceExtname == .xml || resourceExtname == .musicxml || resourceExtname == .mxl",
          "group": "7_modification"
        },
        {
          "command": "lilysharp.importImage",
          "when": "lilysharp.omrAvailable && resourceExtname =~ /^\\.(png|jpe?g|tiff?|pdf)$/i",
          "group": "7_modification"
        },
        {
          "submenu": "lilysharp.export",
          "when": "resourceExtname == .lys",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "lilysharp.aiTransform",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@1"
        },
        {
          "command": "lilysharp.regroup",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@2"
        },
        {
          "command": "lilysharp.splitSectionsToMatch",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@2"
        },
        {
          "command": "lilysharp.convertOctavesToAbsolute",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@2"
        },
        {
          "command": "lilysharp.convertOctavesToRelative",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@2"
        },
        {
          "command": "lilysharp.extractPhrase",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@3"
        },
        {
          "command": "lilysharp.addChordTrack",
          "when": "resourceLangId == lilysharp",
          "group": "1_modification@3"
        }
      ],
      "editor/title": [
        {
          "command": "lilysharp.openPreviewToSide",
          "when": "resourceLangId == lilysharp",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lilysharp.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == lilysharp"
      },
      {
        "command": "lilysharp.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceLangId == lilysharp"
      },
      {
        "command": "lilysharp.aiTransform",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.playNoteAtCursor",
        "key": "alt+p",
        "when": "editorTextFocus && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.playMeasureAtCursor",
        "key": "alt+m",
        "when": "editorTextFocus && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.stepUp",
        "key": "ctrl+shift+up",
        "when": "editorTextFocus && !editorReadonly && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.stepDown",
        "key": "ctrl+shift+down",
        "when": "editorTextFocus && !editorReadonly && editorLangId == lilysharp"
      },
      {
        "command": "lilysharp.smartType",
        "key": "'",
        "args": { "text": "'" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
        "command": "lilysharp.smartType",
        "key": ",",
        "args": { "text": "," },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
        "command": "lilysharp.smartType",
        "key": ".",
        "args": { "text": "." },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
        "command": "lilysharp.smartType",
        "key": "\\",
        "args": { "text": "\\" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
        "command": "lilysharp.smartType",
        "key": "0",
        "args": { "text": "0" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
        "command": "lilysharp.smartType",
        "key": "1",
        "args": { "text": "1" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
        "command": "lilysharp.smartType",
        "key": "2",
        "args": { "text": "2" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
        "command": "lilysharp.smartType",
        "key": "3",
        "args": { "text": "3" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
        "command": "lilysharp.smartType",
        "key": "4",
        "args": { "text": "4" },
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && editorLangId == lilysharp && config.lilysharp.typingAids.enabled"
      },
      {
