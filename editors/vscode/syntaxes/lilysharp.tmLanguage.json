{
    "name": "Lily#",
    "scopeName": "source.lilysharp",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#override-declaration" },
        { "include": "#section-declaration" },
        { "include": "#phrase-declaration" },
        { "include": "#lyrics-block" },
        { "include": "#variable-reference" },
        { "include": "#instrument-value" },
        { "include": "#legacy-keywords" },
        { "include": "#keywords" },
        { "include": "#inline-volta" },
        { "include": "#structures" },
        { "include": "#pitches" },
        { "include": "#rests" },
        { "include": "#durations" },
        { "include": "#barlines" },
        { "include": "#dynamics" },
        { "include": "#music-marks" },
        { "include": "#articulations" },
        { "include": "#numbers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.lilysharp",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.lilysharp",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.lilysharp",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.lilysharp",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "override-declaration": {
            "patterns": [
                {
                    "match": "\\b(once\\s+)?(override)\\s+([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
                    "captures": {
                        "1": { "name": "keyword.control.once.lilysharp" },
                        "2": { "name": "keyword.control.override.lilysharp" },
                        "3": { "name": "entity.name.type.grob.lilysharp" },
                        "4": { "name": "variable.other.property.lilysharp" },
                        "5": { "name": "keyword.operator.assignment.lilysharp" }
                    }
                },
                {
                    "match": "\\b(once\\s+)?(revert)\\s+([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.once.lilysharp" },
                        "2": { "name": "keyword.control.revert.lilysharp" },
                        "3": { "name": "entity.name.type.grob.lilysharp" },
                        "4": { "name": "variable.other.property.lilysharp" }
                    }
                }
            ]
        },
        "section-declaration": {
            "patterns": [
                {
                    "match": "\\b(section)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.section.lilysharp" },
                        "2": { "name": "entity.name.section.lilysharp" }
                    }
                }
            ]
        },
        "phrase-declaration": {
            "patterns": [
                {
                    "match": "\\b(phrase)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.phrase.lilysharp" },
                        "2": { "name": "entity.name.function.phrase.lilysharp" }
                    }
                }
            ]
        },
        "lyrics-block": {
            "comment": "Inside lyrics { … } the words are syllables, not code, so reserved words like 'key'/'time'/'a'/'f' must NOT be highlighted as keywords or pitches. Match the block as its own context that only knows comments, quoted syllables, barlines and the connector tokens; everything else stays plain text. The part-major form `lyrics { section A { … } }` nests one level: #lyrics-inner-section colours the section keyword+name AND balances its braces so this block doesn't end at the inner '}'.",
            "begin": "\\b(lyrics)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(\\{)",
            "beginCaptures": {
                "1": { "name": "keyword.control.lilysharp" },
                "2": { "name": "entity.name.voice.lilysharp" },
                "3": { "name": "punctuation.definition.block.lilysharp" }
            },
            "end": "\\}",
            "endCaptures": {
                "0": { "name": "punctuation.definition.block.lilysharp" }
            },
            "patterns": [
                { "include": "#lyrics-inner-section" },
                { "include": "#lyrics-content" }
            ]
        },
        "lyrics-inner-section": {
            "comment": "Part-major lyric track: `section NAME { … }` written inside lyrics { }. Colour the section keyword and its name; the body is more lyric syllables, and matching the inner braces keeps the outer lyrics block from ending at this section's '}'.",
            "begin": "\\b(section)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
            "beginCaptures": {
                "1": { "name": "keyword.control.section.lilysharp" },
                "2": { "name": "entity.name.section.lilysharp" },
                "3": { "name": "punctuation.definition.block.lilysharp" }
            },
            "end": "\\}",
            "endCaptures": {
                "0": { "name": "punctuation.definition.block.lilysharp" }
            },
            "patterns": [
                { "include": "#lyrics-content" }
            ]
        },
        "lyrics-content": {
            "comment": "The syllable-safe inner tokens of a lyrics block: comments, quoted syllables, barlines and lyric connectors. Everything else stays plain text (a syllable).",
            "patterns": [
                { "include": "#comments" },
                { "include": "#strings" },
                {
                    "name": "punctuation.separator.barline.lilysharp",
                    "match": "\\|"
                },
                {
                    "comment": "Lyric connectors: hyphen (--), extender (__ or _), melisma (~)",
                    "name": "punctuation.separator.lyric-connector.lilysharp",
                    "match": "--|__|~|_"
                }
            ]
        },
        "variable-reference": {
            "patterns": [
                {
                    "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "punctuation.definition.variable.lilysharp" },
                        "2": { "name": "variable.other.reference.lilysharp" }
                    }
                }
            ]
        },
        "instrument-value": {
            "patterns": [
                {
                    "comment": "The preset after 'instrument' is ONE hyphenated word ('electric-bass', 'double-bass'). Highlight the whole name — without this, the generic keyword rule colours only the trailing 'bass' segment and leaves 'electric-' plain. A quoted display label (instrument violin \"1st Violin\") is left to the string rule.",
                    "match": "\\b(instrument)\\s+([A-Za-z0-9]+(?:-[A-Za-z0-9]+)*)",
                    "captures": {
                        "1": { "name": "keyword.other.lilysharp" },
                        "2": { "name": "support.constant.instrument.lilysharp" }
                    }
                }
            ]
        },
        "legacy-keywords": {
            "patterns": [
                {
                    "comment": "Removed LilyPond constructs: the parser rejects bare 'volta'/'alternative' (use the '|: … :| [1. …] [2. …]' form). Highlight as errors.",
                    "name": "invalid.illegal.removed-keyword.lilysharp",
                    "match": "\\b(volta|alternative)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.lilysharp",
                    "match": "\\b(version|score|part|staff|grandStaff|tab|ossia|voice|phrase|section|form|using|drummap|transpose|relative|absolute|repeat|grace|tuplet|acciaccatura|appoggiatura|override|revert|once|lyrics|chords)\\b"
                },
                {
                    "name": "keyword.other.lilysharp",
                    "match": "\\b(title|composer|tempo|time|partial|key|clef|major|minor|ionian|dorian|phrygian|lydian|mixolydian|aeolian|locrian|instrument|octave|channel|tuning|break|treble|bass|alto|tenor|percent|unfold|tremolo)\\b"
                }
            ]
        },
        "inline-volta": {
            "patterns": [
                {
                    "comment": "Inline volta endings: [1. ...] [2. ...] [1-3. ...] [1,3. ...] — '[' + number disambiguates volta vs beam",
                    "match": "(\\[)\\s*(\\d+(?:\\s*[-,]\\s*\\d+)*)(\\.)",
                    "captures": {
                        "1": { "name": "punctuation.definition.volta.lilysharp" },
                        "2": { "name": "constant.numeric.volta.lilysharp" },
                        "3": { "name": "punctuation.definition.volta.lilysharp" }
                    }
                }
            ]
        },
        "structures": {
            "patterns": [
                {
                    "name": "punctuation.definition.block.lilysharp",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.definition.chord.lilysharp",
                    "match": "<(?!<)|>(?!>)"
                },
                {
                    "name": "punctuation.definition.parallel.lilysharp",
                    "match": "<<|>>"
                },
                {
                    "name": "punctuation.separator.lilysharp",
                    "match": "\\\\\\\\|:"
                }
            ]
        },
        "pitches": {
            "patterns": [
                {
                    "name": "variable.other.pitch.lilysharp",
                    "comment": "Accidentals: is/es (sharp/flat), isis/eses (double), isih/eseh + ih/eh (quarter-tones) — the lexer produces no 'as'. Trailing (?![A-Za-z]) so a pitch letter that merely starts a longer word (g in grandStaff, b in bass, c in clef) is NOT mis-highlighted as a note.",
                    "match": "\\b[a-g](isih|eseh|isis|eses|is|es|ih|eh)?[',]*(?![A-Za-z])"
                }
            ]
        },
        "rests": {
            "patterns": [
                {
                    "name": "constant.language.rest.lilysharp",
                    "match": "\\b[rsR]\\b"
                }
            ]
        },
        "durations": {
            "patterns": [
                {
                    "name": "constant.numeric.duration.lilysharp",
                    "match": "\\b(1|2|4|8|16|32|64|128)\\.{0,3}\\b"
                }
            ]
        },
        "barlines": {
            "patterns": [
                {
                    "comment": "Repeat-end with explicit count: :|*N",
                    "match": "(:\\|)(\\*)(\\d+)",
                    "captures": {
                        "1": { "name": "punctuation.separator.barline.lilysharp" },
                        "2": { "name": "keyword.operator.repeat-count.lilysharp" },
                        "3": { "name": "constant.numeric.repeat-count.lilysharp" }
                    }
                },
                {
                    "name": "punctuation.separator.barline.lilysharp",
                    "match": "\\|\\||\\|\\.|\\|:|:\\||\\|"
                }
            ]
        },
        "dynamics": {
            "patterns": [
                {
                    "comment": "@-prefixed dynamics ('f' bare is a PITCH; @f is the dynamic). Backslash dynamics (\\p, \\f) are rejected by the parser — not highlighted as valid.",
                    "name": "keyword.other.dynamic.lilysharp",
                    "match": "@(ppppp|pppp|ppp|pp|mp|mf|p|fffff|ffff|fff|ff|sffz|sfz|sfp|sf|fp|rfz|rf|fz|f|cresc|decresc|dim)\\b"
                }
            ]
        },
        "music-marks": {
            "patterns": [
                {
                    "comment": "Value-carrying annotations take PARENTHESES: @mark(A), @fig(6 4), @chord(Dm), @feather(right), @ped(off), @text(\"dolce\"), @tuplet(3), @finger(1), @bend(…), @notehead(…), @frame(…). (The old dotted form @mark.A / @fig.6.4 was removed.)",
                    "begin": "(@[A-Za-z][A-Za-z0-9]*)\\s*(\\()",
                    "beginCaptures": {
                        "1": { "name": "keyword.other.annotation.lilysharp" },
                        "2": { "name": "punctuation.section.annotation.begin.lilysharp" }
                    },
                    "end": "(\\))",
                    "endCaptures": { "1": { "name": "punctuation.section.annotation.end.lilysharp" } },
                    "patterns": [
                        { "name": "string.quoted.double.lilysharp", "match": "\"[^\"]*\"" }
                    ]
                },
                {
                    "comment": "Plain @name annotation: articulations, ornaments, dynamic text, spanners, navigation marks (@segno/@coda/@fine/@rit…), and any @name-registry name — all resolved from text, so always colored.",
                    "name": "keyword.other.annotation.lilysharp",
                    "match": "@[A-Za-z][A-Za-z0-9]*"
                }
            ]
        },
        "articulations": {
            "patterns": [
                {
                    "name": "keyword.other.articulation.lilysharp",
                    "comment": "Keep in sync with LilySharp.Core ArticulationRegistry (full names + abbreviations).",
                    "match": "@(staccato|stac|accent|acc|tenuto|ten|marcato|marc|fermata|ferm|portato|trill|tr|mordent|prall|turn|invertedturn|pralltriller)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.lilysharp",
                    "match": "\\b\\d+\\b"
                }
            ]
        }
    }
}
