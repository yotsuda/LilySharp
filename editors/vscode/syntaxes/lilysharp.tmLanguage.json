{
    "name": "Lily#",
    "scopeName": "source.lilysharp",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#override-declaration" },
        { "include": "#section-declaration" },
        { "include": "#phrase-declaration" },
        { "include": "#variable-reference" },
        { "include": "#keywords" },
        { "include": "#structures" },
        { "include": "#pitches" },
        { "include": "#rests" },
        { "include": "#durations" },
        { "include": "#barlines" },
        { "include": "#dynamics" },
        { "include": "#music-marks" },
        { "include": "#articulations" },
        { "include": "#numbers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.lilysharp",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.lilysharp",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.lilysharp",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.lilysharp",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "override-declaration": {
            "patterns": [
                {
                    "match": "\\b(once\\s+)?(override)\\s+([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
                    "captures": {
                        "1": { "name": "keyword.control.once.lilysharp" },
                        "2": { "name": "keyword.control.override.lilysharp" },
                        "3": { "name": "entity.name.type.grob.lilysharp" },
                        "4": { "name": "variable.other.property.lilysharp" },
                        "5": { "name": "keyword.operator.assignment.lilysharp" }
                    }
                },
                {
                    "match": "\\b(once\\s+)?(revert)\\s+([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.once.lilysharp" },
                        "2": { "name": "keyword.control.revert.lilysharp" },
                        "3": { "name": "entity.name.type.grob.lilysharp" },
                        "4": { "name": "variable.other.property.lilysharp" }
                    }
                }
            ]
        },
        "section-declaration": {
            "patterns": [
                {
                    "match": "\\b(section)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.section.lilysharp" },
                        "2": { "name": "entity.name.section.lilysharp" }
                    }
                }
            ]
        },
        "phrase-declaration": {
            "patterns": [
                {
                    "match": "\\b(phrase)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.phrase.lilysharp" },
                        "2": { "name": "entity.name.function.phrase.lilysharp" }
                    }
                }
            ]
        },
        "variable-reference": {
            "patterns": [
                {
                    "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "punctuation.definition.variable.lilysharp" },
                        "2": { "name": "variable.other.reference.lilysharp" }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.lilysharp",
                    "match": "\\b(score|part|staff|voice|relative|absolute|fixed|repeat|volta|alternative|let|use|structure|render|grace|tuplet|acciaccatura|appoggiatura|override|revert|once|lyrics)\\b"
                },
                {
                    "name": "keyword.other.lilysharp",
                    "match": "\\b(title|composer|tempo|time|key|clef|major|minor|instrument|octave|channel|tuning|treble|bass|alto|tenor|percent|unfold)\\b"
                }
            ]
        },
        "structures": {
            "patterns": [
                {
                    "name": "punctuation.definition.block.lilysharp",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.definition.chord.lilysharp",
                    "match": "<(?!<)|>(?!>)"
                },
                {
                    "name": "punctuation.definition.parallel.lilysharp",
                    "match": "<<|>>"
                },
                {
                    "name": "punctuation.separator.lilysharp",
                    "match": "\\\\\\\\|:"
                }
            ]
        },
        "pitches": {
            "patterns": [
                {
                    "name": "variable.other.pitch.lilysharp",
                    "match": "\\b[a-g](isis|eses|is|es|as)?[',]*"
                }
            ]
        },
        "rests": {
            "patterns": [
                {
                    "name": "constant.language.rest.lilysharp",
                    "match": "\\b[rsR]\\b"
                }
            ]
        },
        "durations": {
            "patterns": [
                {
                    "name": "constant.numeric.duration.lilysharp",
                    "match": "\\b(1|2|4|8|16|32|64|128)\\.{0,3}\\b"
                }
            ]
        },
        "barlines": {
            "patterns": [
                {
                    "name": "punctuation.separator.barline.lilysharp",
                    "match": "\\|\\||\\|\\.|\\|:|:\\||\\|"
                }
            ]
        },
        "dynamics": {
            "patterns": [
                {
                    "name": "keyword.other.dynamic.lilysharp",
                    "match": "@(ppp|pp|p|mp|mf|f|ff|fff|sfz|sfp|fp|cresc|decresc|dim)\\b"
                },
                {
                    "comment": "Legacy backslash dynamics for backwards compatibility",
                    "name": "keyword.other.dynamic.legacy.lilysharp",
                    "match": "\\\\(ppp|pp|p|mp|mf|f|ff|fff|cresc|decresc|dim)\\b"
                }
            ]
        },
        "music-marks": {
            "patterns": [
                {
                    "comment": "Navigation marks",
                    "name": "keyword.other.mark.lilysharp",
                    "match": "@(segno|coda|fine|dc|ds\\.al\\.fine|ds\\.al\\.coda)\\b"
                },
                {
                    "comment": "Rehearsal marks",
                    "name": "keyword.other.mark.lilysharp",
                    "match": "@mark\\.[A-Za-z0-9]+"
                },
                {
                    "comment": "Pedal markings",
                    "name": "keyword.other.pedal.lilysharp",
                    "match": "@(ped|ped\\.off|sost\\.ped|sostenuto|una\\.corda|tre\\.corde)\\b"
                },
                {
                    "comment": "Ottava brackets",
                    "name": "keyword.other.ottava.lilysharp",
                    "match": "@(ottava|ottava\\.bassa|loco)\\b"
                },
                {
                    "comment": "Text spanners",
                    "name": "keyword.other.spanner.lilysharp",
                    "match": "@(rit|accel|startTrillSpan|stopTrillSpan)\\b"
                },
                {
                    "comment": "Figured bass",
                    "name": "keyword.other.figuredbass.lilysharp",
                    "match": "@fig(\\.[0-9sfn]+)+"
                },
                {
                    "comment": "Chord names",
                    "name": "keyword.other.chordname.lilysharp",
                    "match": "@chord\\.[A-Za-z0-9#b/]+"
                },
                {
                    "comment": "Feathered beams",
                    "name": "keyword.other.feather.lilysharp",
                    "match": "@feather\\.(right|left|accel|rit)\\b"
                },
                {
                    "comment": "Cross-staff and other annotations",
                    "name": "keyword.other.annotation.lilysharp",
                    "match": "@(cross|gliss|arpeggio|courtesy)\\b"
                }
            ]
        },
        "articulations": {
            "patterns": [
                {
                    "name": "keyword.other.articulation.lilysharp",
                    "match": "@(staccato|accent|tenuto|marcato|fermata|portato|trill|mordent|prall|turn|invertedturn|pralltriller)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.lilysharp",
                    "match": "\\b\\d+\\b"
                }
            ]
        }
    }
}
