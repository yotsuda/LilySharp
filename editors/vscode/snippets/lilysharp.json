{
    "Simple Score": {
        "prefix": "score",
        "body": [
            "title \"${1:Title}\"",
            "composer \"${2:Composer}\"",
            "tempo ${3:120}",
            "time ${4:4/4}",
            "key ${5:c} ${6|major,minor|}",
            "",
            "${0}"
        ],
        "description": "Create a simple score with metadata"
    },
    "Grand Staff (Piano)": {
        "prefix": "piano",
        "body": [
            "title \"${1:Title}\"",
            "tempo ${2:120}",
            "time ${3:4/4}",
            "key ${4:c} ${5|major,minor|}",
            "",
            "part rightHand { clef: treble }",
            "part leftHand { clef: bass }",
            "",
            "section ${6:Main} {",
            "\trightHand { ${7:c'4 d' e' f' | g'2 g' |} }",
            "\tleftHand  { ${8:c2 g, | c g, |} }",
            "}",
            "",
            "render score {",
            "\tgrandStaff {",
            "\t\tstaff treble { rightHand }",
            "\t\tstaff bass { leftHand }",
            "\t}",
            "}",
            "",
            "structure { ${6:Main} }"
        ],
        "description": "Create a grand staff (piano) score"
    },
    "Section": {
        "prefix": "section",
        "body": [
            "section ${1:Name} {",
            "\t${2:partName} { ${0} }",
            "}"
        ],
        "description": "Section with part block"
    },
    "Phrase": {
        "prefix": "phrase",
        "body": [
            "phrase ${1:name} {",
            "\t${0}",
            "}"
        ],
        "description": "Reusable phrase declaration"
    },
    "Repeat Volta": {
        "prefix": "repeat",
        "body": [
            "repeat volta ${1:2} {",
            "\t${0}",
            "}"
        ],
        "description": "Volta repeat"
    },
    "Repeat with Alternatives": {
        "prefix": "repeat-alt",
        "body": [
            "repeat volta ${1:2} {",
            "\t${2}",
            "}",
            "alternative {",
            "\t{ ${3} }",
            "\t{ ${0} }",
            "}"
        ],
        "description": "Volta repeat with alternative endings"
    },
    "Tuplet": {
        "prefix": "tuplet",
        "body": "tuplet ${1:3/2} { ${0} }",
        "description": "Tuplet (e.g., triplet 3/2)"
    },
    "Grace Note": {
        "prefix": "grace",
        "body": "grace { ${0} }",
        "description": "Grace notes"
    },
    "Acciaccatura": {
        "prefix": "acciaccatura",
        "body": "acciaccatura { ${1:d16} } ${0}",
        "description": "Slashed grace note (takes no time)"
    },
    "Appoggiatura": {
        "prefix": "appoggiatura",
        "body": "appoggiatura { ${1:c8} } ${0}",
        "description": "Unslashed grace note"
    },
    "Override Property": {
        "prefix": "override",
        "body": "override ${1:Stem}.${2:length} = ${0}",
        "description": "Override a grob property"
    },
    "Once Override": {
        "prefix": "once-override",
        "body": "once override ${1:NoteHead}.${2:color} = ${0}",
        "description": "One-time grob property override"
    },
    "Revert Property": {
        "prefix": "revert",
        "body": "revert ${1:Stem}.${2:length}",
        "description": "Revert a grob property to default"
    },
    "Render Score": {
        "prefix": "render",
        "body": [
            "render score {",
            "\t${1|staff,grandStaff|} {",
            "\t\t${0}",
            "\t}",
            "}"
        ],
        "description": "Output layout declaration"
    },
    "Structure": {
        "prefix": "structure",
        "body": "structure { ${0} }",
        "description": "Playback order of sections"
    },
    "Lyrics": {
        "prefix": "lyrics",
        "body": [
            "lyrics {",
            "\t${0}",
            "}"
        ],
        "description": "Lyrics block"
    },
    "Part Declaration": {
        "prefix": "part",
        "body": "part ${1:name} { clef: ${2|treble,bass,alto,tenor|} }",
        "description": "Part declaration with clef"
    },
    "Key Signature": {
        "prefix": "key",
        "body": "key ${1:c} ${2|major,minor|}",
        "description": "Key signature"
    },
    "Time Signature": {
        "prefix": "time",
        "body": "time ${1|4/4,3/4,6/8,2/2,2/4,3/8|}",
        "description": "Time signature"
    },
    "Tempo Marking": {
        "prefix": "tempo",
        "body": "tempo ${1|\"Allegro\",\"Andante\",\"Adagio\",\"Moderato\",\"Presto\"|}${2: 4 = }${3:120}",
        "description": "Tempo with optional text marking"
    }
}
