// Greensleeves — English traditional (16th century), public domain.
//
// ONE progression (`chords prog`), used TWICE without duplication:
//   "greensleeves"      — melody staff with the chord symbols aligned above it
//                         (`staff melody with chords prog`) and verse lyrics
//   "greensleeves-grid" — the same progression as a staff-less chord grid
title "Greensleeves"
composer "Traditional"
tempo 60
time 6/8
key a minor
octave absolute

part melody { clef treble }

section Verse {
  partial 8
  melody {
    a8 |
    c'4 d'8 e'8. f'16 e'8 |
    d'4 b8 g8. a16 b8 |
    c'4 a8 a8. gis16 a8 |
    b4 gis8 e4 a8 |
    c'4 d'8 e'8. f'16 e'8 |
    d'4 b8 g8. a16 b8 |
    c'8. b16 a8 gis8. fis16 gis8 |
    a4. a4 r8 |
  }
  chords prog {
    |
    a2.:m | g2. | a2.:m | e2. |
    a2.:m | g2. | a4.:m e4. | a2.:m |
  }
  lyrics words sings melody {
    A- |
    las my love ~ you | do me wrong ~ to |
    cast me off ~ dis- | cour- teous- ly and |
    I have lov- ~ ed | you so long ~ de- |
    light- ~ ing in your com- | pa- ny |
  }
}

section Chorus {
  melody {
    g'4. g'8. fis'16 e'8 |
    d'4 b8 g8. a16 b8 |
    c'4 a8 a8. gis16 a8 |
    b4 gis8 e4. |
    g'4. g'8. fis'16 e'8 |
    d'4 b8 g8. a16 b8 |
    c'8. b16 a8 gis8. fis16 gis8 |
    a4. a4. |
  }
  chords prog {
    c2. | g2. | a2.:m | e2. |
    c2. | g2. | a4.:m e4. | a2.:m |
  }
  lyrics words sings melody {
    Green- sleeves ~ was | all my joy ~ Green- |
    sleeves was my ~ de- | light ~ Green- |
    sleeves was ~ my | heart of gold ~ and |
    who but my la- ~ dy | Green- sleeves |
  }
}

form main { Verse Chorus }

score main "greensleeves" {
  staff melody with chords prog with lyrics words
}

score main "greensleeves-grid" {
  chords prog
}
