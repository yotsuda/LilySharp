// Key Signature Test - D major (2 sharps)
title "D Major Test"
composer "LilySharp"

tempo 120
time 4/4
key d major

part melody {
  clef: treble
}

phrase test {
  f4 a fis g | a4 b cis d |
}

section Main {
  melody { test }
}

structure { Main }

render score "keysig-d-major.svg" {
  staff { melody }
}
