// Fur Elise (opening) in Lily#
title "Fur Elise"
composer "Ludwig van Beethoven"

tempo 76
time 3/8
key a minor

part rightHand {
  clef: treble
}

part leftHand {
  clef: bass
}

// Reusable theme
phrase mainTheme {
  e8 dis e | dis e b | d c a~ |
  a4. | r8 c e |
  a4. | r8 e gis |
  b4. | r8 e gis |
  a4. | r4 r8 |
}

section Main {
  rightHand { mainTheme }
  leftHand {
    r4. | a,8 e a |
    c4. | r8 e a |
    c4. | r8 e gis |
    b4. | r8 e gis |
    a4. | a8 c e |
  }
}

structure { Main }

render score "fur-elise.svg" {
  grandStaff {
    staff { rightHand }
    staff { leftHand }
  }
}

render midi "fur-elise.mid" {
  rightHand channel: 1 instrument: 1
  leftHand channel: 2 instrument: 1
}
