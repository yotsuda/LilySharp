// Für Elise — Ludwig van Beethoven (1770–1827), public domain.
// Excerpt: the famous A section and first episode (simplified arrangement).
//
// Lily# features on display:
//   octaves          — LilyPond's, relative: each note takes the octave nearest the one before
//   phrase / ref     — the A theme is written once and played twice
//   partial 8        — the pickup, declared ONCE for all parts of the section
title "Für Elise"
composer "L. v. Beethoven"
tempo 120
time 3/8
key a minor

part rh { clef treble }
part lh { clef bass }

phrase themeA_rh {
  e''16 dis e b d c |
  a8 r16 c, e a |
  b8 r16 e, gis b |
  c8 r16 e, e' dis |
  e16 dis e b d c |
  a8 r16 c, e a |
  b8 r16 e, c' b |
  a4 r8 |
}

phrase themeA_lh {
  r4. |
  a,16 e' a r16 r8 |
  e,16 e' gis r16 r8 |
  a,16 e' a r16 r8 |
  r4. |
  a,16 e' a r16 r8 |
  e,16 e' gis r16 r8 |
  a,16 e' a r16 r8 |
}

section Main {
  partial 8
  rh {
    e''16@pp dis |
    themeA_rh
    e''8. g16 f e |
    d8. f16 e d |
    c8. e16 d c |
    b8 r16 e, e' dis |
    themeA_rh
  }
  lh {
    r8 |
    themeA_lh
    c,16 g' c r16 r8 |
    g,16 g' b r16 r8 |
    a,16 e' a r16 r8 |
    e,16 e' gis r16 r8 |
    themeA_lh
  }
}

form { Main }

score {
  grandStaff {
    staff rh
    staff lh
  }
}
