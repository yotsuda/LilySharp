// Für Elise — Ludwig van Beethoven (1770–1827), public domain.
// Excerpt: the famous A section and first episode (simplified arrangement).
//
// Lily# features on display:
//   octave absolute  — every pitch is anchored to C4; nothing drifts
//   part { octave 3 }— the bass re-anchors to C3, so no comma pile-up
//   phrase / $ref    — the A theme is written once and played twice
//   partial 8        — the two-sixteenth pickup
title "Für Elise"
composer "L. v. Beethoven"
tempo 120
time 3/8
key a minor
octave absolute

part rh { clef treble }
part lh { clef bass octave 3 }

phrase themeA_rh {
  e'16 dis' e' b d' c' |
  a8 r16 c e a |
  b8 r16 e gis b |
  c'8 r16 e e' dis' |
  e'16 dis' e' b d' c' |
  a8 r16 c e a |
  b8 r16 e c' b |
  a4 r8 |
}

phrase themeA_lh {
  r4. |
  a,16 e a r16 r8 |
  e,16 e gis r16 r8 |
  a,16 e a r16 r8 |
  r4. |
  a,16 e a r16 r8 |
  e,16 e gis r16 r8 |
  a,16 e a r16 r8 |
}

section Main {
  rh {
    partial 8
    e'16@pp dis' |
    $themeA_rh
    e'8. g'16 f' e' |
    d'8. f'16 e' d' |
    c'8. e'16 d' c' |
    b8 r16 e e' dis' |
    $themeA_rh
  }
  lh {
    partial 8
    r8 |
    $themeA_lh
    c16 g c' r16 r8 |
    g,16 g b r16 r8 |
    a,16 e a r16 r8 |
    e,16 e gis r16 r8 |
    $themeA_lh
  }
}

structure { Main }

score "fur-elise" {
  grandStaff {
    staff rh
    staff lh
  }
}
