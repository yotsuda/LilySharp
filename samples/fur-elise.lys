// Fur Elise (opening) in Lily#
title "Fur Elise"
composer "Ludwig van Beethoven"
tempo 76
time 3/8
key a minor

let mainTheme = relative c'' {
    // Pickup + opening phrase (3 eighth notes per measure)
    e8 dis e | dis e b | d c a~ |
    a4. | r8 c e |
    a4. | r8 e gis |
    b4. | r8 e, gis |
    a4. | r4 r8 |
}

score {
    part Piano {
        staff RH {
            clef: treble
            use mainTheme
        }
        staff LH {
            clef: bass
            relative c {
                r4. | a8 e' a |
                c4. | r8 e, a |
                c4. | r8 e, gis |
                b4. | r8 e, gis |
                a4. | a,8 c e |
            }
        }
    }
}