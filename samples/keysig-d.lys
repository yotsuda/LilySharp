// Key Signature Test - D major (F#, C#)
title "D Major Test"
composer "LilySharp"

tempo 120
time 4/4
key d major

part melody {
  clef: treble
}

phrase test {
  d'4 e' fis' g' | a'4 b' cis'' d'' |
}

section Main {
  melody { test }
}

structure { Main }

render score "keysig-d.svg" {
  staff { melody }
}
