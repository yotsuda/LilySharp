// Key Signature and Time Signature Test
title "Notation Test"
composer "LilySharp"

tempo 120
time 3/4
key d major

part melody {
  clef: treble
}

phrase test {
  d4 e fis | g4 a b | cis2 d |
}

section Main {
  melody { test }
}

structure { Main }

render score "notation-test.svg" {
  staff { melody }
}
