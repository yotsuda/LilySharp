// Cue notes example
// Notes marked with @cue are rendered at reduced size (66%)
// LILYPOND-REF: ly/engraver-init.ly CueVoice context — fontSize = #-4

title "Cue Notes Demo"
tempo 120
time 4/4
key c major

// Single notes: normal c' d', then cue e' f'
// Second measure: normal g' a', then cue b' c''
melody = { c'4 d' e'@cue f'@cue | g'4 a' b'@cue c''@cue | c'1 | }

// Chords: normal then cue
chords = { <c' e' g'>4 <d' f' a'>4 <e' g' b'>4@cue <f' a' c''>4@cue | <c' e' g'>1 | }

render score "cue-melody" {
  staff treble { melody }
}

render score "cue-chords" {
  staff treble { chords }
}
