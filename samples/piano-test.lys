title "Piano Test"
time 4/4
tempo 120

part rightHand {
  clef: treble
}

part leftHand {
  clef: bass
}

phrase rightHandMusic { c''4 d e f | g2 g | }
phrase leftHandMusic { c,4 e g c' | c2 c | }

section Main {
  rightHand { rightHandMusic }
  leftHand { leftHandMusic }
}

structure { Main }

render score "piano-test.svg" {
  grandStaff {
    staff { rightHand }
    staff { leftHand }
  }
}