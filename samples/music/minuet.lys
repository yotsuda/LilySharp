// Minuet in G in Lily#
title "Minuet in G"
composer "J.S. Bach"

tempo 108
time 3/4
key g major

part rightHand {
  clef: treble
}

part leftHand {
  clef: bass
}

section A {
  rightHand {
    d'4 g,8 a b c |
    d4 g, g |
    e'4 c8 b c a |
    d,4 fis8 e fis d |
  }
  leftHand {
    g2 a4 |
    b2. |
    c2. |
    d2. |
  }
}

section A1 {
  rightHand { g'4 g g | }
  leftHand { g2. | }
}

section A2 {
  rightHand { g'4 g2 | }
  leftHand { g2. | }
}

structure {
  |: A [1. A1] [2. A2] :|
}

render score "minuet.svg" {
  grandStaff {
    staff { rightHand }
    staff { leftHand }
  }
}

render midi "minuet.mid" {
  rightHand channel: 1 instrument: 1
  leftHand channel: 2 instrument: 1
}