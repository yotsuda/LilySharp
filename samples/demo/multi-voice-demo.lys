// Multi-Voice Demo for Lily#
// Two voices on one staff

title "Multi-Voice Demo"
tempo 80
time 4/4

part melody

section Main {
  // Two voices: upper (stems up) and lower (stems down)
  melody { << { c'2 d | e2 f | g2 a | b2 c' | } \\ { e2 f | g2 a | b2 c' | d2 e | } >> }
}

structure { Main }

render score "multi-voice-demo.svg" {
  staff { melody }
}
