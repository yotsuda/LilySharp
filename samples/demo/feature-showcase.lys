// Feature Showcase - Demonstrates all implemented features
// Lily# Music Notation Compiler

title "Feature Showcase"
composer "LilySharp Demo"

tempo 120
time 4/4
key c major

part melody

// === Phase 1: Basic Glyph Placement ===
phrase basicNotes {
  // Various note values
  c1 |                    // Whole note
  c2 d2 |                // Half notes
  c4 d4 e4 f4 |        // Quarter notes
  c8 d e f g f e d | // Eighth notes (beamed)
  c4. d8 e4. f8 |      // Dotted notes
  g2. r4 |                // Dotted half + rest
  r1 |                     // Whole rest
  r2 r4 r8 r8 |            // Various rests
}

// === Accidentals ===
phrase accidentals {
  c4 cis d dis |       // Sharps
  e4 ees d des |       // Flats
  c4 d e f |           // Natural
  g4 fis e dis |       // More sharps
}

// === Beaming ===
phrase beaming {
  c8 d e f g f e d |      // 8th beams
  c16 d e f g f e d c d e f g f e d | // 16th beams
  c8 d16 e f8 g16 a g8 f16 e d4 |     // Mixed beams
}

// === Ties and Slurs ===
phrase tiesAndSlurs {
  c4~ c4 d2 |           // Tie
  d2 e2~ | e4 f g a |    // Tie across barline
  c4( d e f) |         // Slur
  g4( f e d) c2 r2 |  // Slur down
}

// === Chords ===
phrase chords {
  <c e g>4 <d f a> <e g b> <f a c'> |
  <c e g>4 <c eis gis> <c f a> <c e g> |
  <c e g>2 <d f a>2 |
  <e g b>2 <c e g>2 |
}

// === Musical Passage ===
phrase musicalPassage {
  c4 e g e |
  f4 a g f |
  e8 f g a g f e d |
  c2. r4 |
}

section Demo {
  melody { $basicNotes $accidentals $beaming $tiesAndSlurs $chords $musicalPassage }
}

structure { Demo }

render score "feature-showcase.svg" {
  staff { melody }
}
