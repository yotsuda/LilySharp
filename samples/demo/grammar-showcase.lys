// LilySharp Grammar Showcase - All Features
title "Grammar Showcase"
composer "LilySharp"

tempo 120
time 4/4
key g major

// === part definitions (with clef option) ===
part melody { clef: treble }
part bassLine { clef: bass }

// === phrase definitions (reusable phrases) ===
phrase intro {
  c4 d e f |          // Basic notes
  g8 a b c' d c b a | // 8th notes (auto-beamed)
  <c e g>4 <d f a>2. |  // Chords
}

phrase verse {
  c4. d8 e4 f |        // Dotted notes
  g4~ g4 a2 |          // Tie
  c4( d e f) |         // Slur
  g4@staccato a@accent b@tenuto c@marcato |  // Articulations
}

phrase dynamics {
  c4@p d@cresc e f@f | // Dynamics
  g4@trill a@mordent b@turn c@prall |  // Ornaments
  grace { d16 e } f4 g2 |  // Grace notes
  acciaccatura { a16 } b4 r2 |  // Acciaccatura
}

phrase accidentals {
  c4 cis d dis |       // Sharps
  e4 ees d des |       // Flats
  fis4 ges a bes |     // Others
}

phrase tuplets {
  tuplet 3/2 { c4 d e } f2 |  // Tuplet
  r4 r8 r16 r16 r2 |   // Rests
}

// === multi-voice (parallel expression) ===
phrase polyphony {
  << { c'2 d } \\ { e2 f } >> |  // 2 voices
  << { g2 } \\ { b,2 } \\ { d2 } >> r2 |  // 3 voices
}

// === section definitions ===
section Intro {
  melody { $intro }
  bassLine { c2 g | c2. r4 | c1 | }
}

section Verse {
  melody { $verse $dynamics }
  bassLine { c2 g2 | c2 g2 | c1 | c1 | }
}

section Bridge {
  key d major  // Key change within section
  melody { $accidentals $tuplets }
  bassLine { d2 a2 | d2 a2 | }
}

section Coda {
  melody { $polyphony }
  bassLine { c1 | g1 | }
}

// === structure (repeats, volta) ===
structure {
  Intro
  |: Verse [1. Bridge] [2. Coda] :|
}

// === render output ===
render score "grammar-showcase.svg" {
  grandStaff {
    staff { melody }
    staff { bassLine }
  }
}

render midi "grammar-showcase.mid" {
  melody channel: 1 instrument: 1
  bassLine channel: 2 instrument: 33
}
