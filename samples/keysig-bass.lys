// Key Signature Test - Bass clef with F major (1 flat)
title "F Major Bass Test"
composer "LilySharp"

tempo 120
time 4/4
key f major

part left_hand {
  clef: bass
}

phrase test {
  f,4 g, a, bes, | c4 d e f |
}

section Main {
  left_hand { test }
}

structure { Main }

render score "keysig-bass.svg" {
  staff { left_hand }
}
