// Piano Test
title "Piano"
tempo 120
time 4/4

part rightHand {
  clef: treble
}

part leftHand {
  clef: bass
}

phrase rightHandMusic {
  // Start at C5 (c'), then relative from there
  c'4 d e f | g2 g |
}

phrase leftHandMusic {
  // Start at C3 (c,), then relative
  c,4 e g c' | c2 c |
}

section Main {
  rightHand { $rightHandMusic }
  leftHand { $leftHandMusic }
}

structure { Main }

render score "piano.svg" {
  grandStaff {
    staff { rightHand }
    staff { leftHand }
  }
}
