// Ukulele Tablature Example in Lily#
// Standard tuning: G C E A

title "Ukulele Tab Demo"
tempo 120
time 4/4

part ukulele {
  clef: treble
  tuning: ukulele
}

section Main {
  ukulele {
    // C major chord strum
    <c e g c'>4 <c e g c'> <c e g c'> <c e g c'> |

    // Simple melody (C4 range, ascending scale)
    c4 d e f | g4 a b c' |
  }
}

structure { Main }

render score "ukulele-tab.svg" {
  staff { ukulele }
  tab ukulele { ukulele }
}

render midi "ukulele-tab.mid" {
  ukulele channel: 1 instrument: 24
}
