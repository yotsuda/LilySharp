<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.15.x is the first line that knows about .NET 10: RuntimeMoniker.Net10_0
         (and the toolchain that builds the generated job project) does not exist
         in 0.14.0, so the [SimpleJob] moniker below cannot name net10.0 there. -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LilySharp.Core\LilySharp.Core.csproj" />
  </ItemGroup>

</Project>
