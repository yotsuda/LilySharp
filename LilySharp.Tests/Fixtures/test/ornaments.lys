// Ornaments Test
// Tests @trill, @mordent, @prall, @turn, @reverseturn, @pralltriller, :8 tremolo
title "Ornaments"
composer "Lily#"

tempo 100
time 4/4
key c major

part melody

phrase trills {
  c2@trill d2@trill |
  e2@trill f2 |
}

phrase mordentPrall {
  c4@mordent d@prall e@mordent f@prall |
}

phrase turns {
  c2@turn d2@reverseturn |
  e2@pralltriller f2 |
}

phrase tremoloTest {
  c2:8 d2:16 |
}

section Main {
  melody { trills mordentPrall turns tremoloTest }
}

form main { Main }

score main "ornaments" {
  staff melody
}
