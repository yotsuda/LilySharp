// Coverage: a 'partial' (anacrusis / pickup) declaration. 'partial 4' opens a
// quarter-note pickup that auto-completes after one quarter; the meter then
// resumes (4/4), so the following measures fill normally. LILYPOND-REF:
// ly/music-functions-init.ly:1670-1678 \partial (PartialSet on Timing).
title "Pickup measure"
key c major
part m { clef treble }
section Main {
  m {
    time 4/4
    partial 4
    g4 | c4 d e f | g2 e2 | c1 |
  }
}
structure { Main }
score "partial-pickup" { staff m }
