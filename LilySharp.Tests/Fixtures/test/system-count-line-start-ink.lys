// The count loop prices each candidate line by ITS OWN line-start ink, not by the first
// line's. The first line carries the tempo and the "Intro" box over its prefix; the
// continuation lines carry a clef and a bar number. LilyPond 2.26.0 engraves this excerpt
// (the real-corpus book "Le Freak", bars 1-57, staff + tab) in 11 systems —
// 5 | 4 | 4 | 12 | 4 | 6 | 2 | 8 | 4 | 4 | 4 on the hand-written book, the sixteen bars of
// A1 as 4 + 12 (the twin ties A1 the other way, 6 + 10, at the same count: the two
// breakings are 0.02 demerits apart at the DP state that decides them, and bars 10-11
// are 1.3 ss wider in Lily# than in LilyPond — not the twin's string numbers nor its tab
// mode, both measured). Priced with the first line's ink on every
// line, six systems fit a page where eight do, the ideal count needs a page more than the
// count below it, and the loop stops one count short (optimal-page-breaking.cc:183-185),
// engraving 12 systems with A1 as 4 + 6 + 6. (session 335, scratch/p335)
octave absolute
title "Le Freak"
composer "Chic"
tempo 120
key c major

section Body { partial 8 }
part bassline {
  clef bass
  tuning bass

  section Body { g,,8@mark("Intro") | a,,4\4@fall r2. | r2.. g,,8 | a,,4\4 r2. | r2.. g,,8 | break
    a,,4\4@fall r2. | r2.. g,,8 | a,,4\4 r2. | r4.. e,,16 a,,\4 a,\2 e,,8 g,, gis,, | break
    repeat percent 8 { a,,4\4@mark("A1") r8 g,,16 a,,\4 c, c, a,,8\4 g,, a,,\4 | d,8.\3 d,16\3 r8 g,,16 a,,\4 c,8. c,16 r16 g,,@dead g,,8 | } break
    a,,4\4@fall@mark("B1") r2. | r2.. g,,8 | a,,4\4 r2. | r4.. e,,16 a,,\4 a,\2 e,,8 g,, gis,, | break
    repeat percent 3 { a,,4\4@mark("A2") r8 g,,16 a,,\4 c, c, a,,8\4 g,, a,,\4 | d,8.\3 d,16\3 r8 g,,16 a,,\4 c,8. c,16 r16 g,,@dead g,,8 | } break
    a,,4\4@mark("A2") r8 g,,16 a,,\4 c, c, a,,8\4 g,, a,,\4 | d,8.\3 d,16\3 r8 g,16\2 a,\2 c4 r16 g,,@dead g,,8 | break
    repeat percent 4 { a,,4\4 r8 g,,16 a,,\4 c, c, a,,8\4 g,, a,,\4 | d,8.\3 d,16\3 r8 g,,16 a,,\4 c,8. c,16 r16 g,,@dead g,,8 | } break
    a,,4\4@fall@mark("B2") r2. | r2.. g,,8 | a,,4\4 r2. | r4.. e,,16 a,,\4 a,\2 e,,8 g,, gis,, | break
    a,,\4@mark("C1") c c a,\2 c a,\2 c16 a,8\2 a,,16 | r8 c c a,\2 c a,\2 c16 a,8\2 d,16 | r8 c c a,\2 c a,\2 c16 a,8\2 d,16 | r8 c c a,\2 c a,\2 c16 a,8\2 a,,16 | break
    r8 c c a,\2 c a,\2 c16 a,8\2 a,,16 | r8 c c a,\2 c a,\2 c16 a,8\2 d,16 | r8 c c a,\2 c a,\2 c16 a,8\2 d,16 | r8 c c a,\2 c a,\2 c16 a,8\2 a,,16 | break
  }
}

form main { ~Body }

score main {
  staff bassline
  tab bassline
}
