// Pedal TEXT style (part property `pedal text`): "Ped." at the engage note and
// "*" at the release, with no bracket — LilyPond's pedalSustainStyle = 'text.
// LILYPOND-REF: lily/piano-pedal-engraver.cc — create_text_grobs.
title "Pedal text"
time 4/4

part lh {
  clef bass
  pedal text
}

section Main {
  lh { c4 d e@sustainOn f | g4 a b@sustainOff c | }
}

form main { Main }

score main "pedal-text" {
  staff lh
}
