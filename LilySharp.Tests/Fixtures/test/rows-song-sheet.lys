// Staff-less song sheet: a chord ROW and a lyric ROW, no staves at all.
// Pins the row machinery end-to-end: even-spread syllables sized by REAL
// text widths (a capital-heavy line must not overlap), the line-break X
// rewind (bar 5 starts a new line - its first syllable must NOT be shoved
// right by a phantom overlap with the previous line), squeezed hyphen
// dashes, and the title-only header ink clearance.
title "Rows sheet"
time 4/4

section Main {
  chords prog { C | G | Am | F | C | G | F G | C | }
  lyrics words {
    Twin- kle twin- kle | lit- tle star | how I won- der | what you are |
    Up a- bove the | world so high | like a dia- mond | in the sky |
  }
}

form main { Main }

score main "rows-song-sheet" {
  chords prog
  lyrics words
}
