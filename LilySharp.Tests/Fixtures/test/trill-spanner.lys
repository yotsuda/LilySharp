// Trill Spanner Test
// Tests trill spanners (tr + wavy line extension)
title "Trill Spanners"
composer "Lily#"

tempo 120
time 4/4
key c major

part melody {
  clef treble
}

// Simple trill spanner across two notes
phrase m1 { c''4@trillSpan d e f@!trillSpan | g4 a b c' | }

// Trill spanner spanning a full measure
phrase m2 { c''4@trillSpan d e f | g4 a b c'@!trillSpan | }

// Multiple trill spanners
phrase m3 { c''4@trillSpan d@!trillSpan e4@trillSpan f@!trillSpan | g4 a b c' | }

section A { melody { m1 } }
section B { melody { m2 } }
section C { melody { m3 } }

form { A B C }

score { staff melody }
