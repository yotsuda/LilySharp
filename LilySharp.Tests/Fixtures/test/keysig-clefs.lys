// Key Signature Test - Multiple Clefs
// Based on: keysig-clefs
title "Key Signatures (Multiple Clefs)"
composer "Lily#"

tempo 120
time 4/4
key d major  // 2 sharps: F#, C#

part treblePart {
  clef treble
}
part bassPart {
  clef bass
}

phrase treblePhrase {
  d4 e fis g | a4 b cis' d |
}
phrase bassPhrase {
  d4 e fis g | a4 b cis d |
}

section Main {
  treblePart { $treblePhrase }
  bassPart { $bassPhrase }
}

structure { Main }

score "keysig-clefs" {
  grandStaff {
    staff { treblePart }
    staff { bassPart }
  }
}
