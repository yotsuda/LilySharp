// Ties and Slurs Test
// Consolidates: tie-test, tie-slur-test
title "Ties and Slurs"
composer "Lily#"

tempo 120
time 4/4
key c major

part melody

phrase ties {
  // Basic tie
  c4~ c4 d2 |
  // Tie across barline
  d2 e2~ | e4 f g a |
}

phrase slurs {
  // Basic slur
  c4( d e f) |
  // Descending slur
  g4( f e d) c2 r2 |
}

phrase tieDirection {
  // Low note (stem up) - tie curves down
  c4~ c4 r2 |
  // High note (stem down) - tie curves up
  // ⚠️ THE `|.` IS LOAD-BEARING and must stay written. This fixture is the Lily# side of
  // the ledger pair `compressed.line-start.time-to-first-note` (probe score TSJ), whose
  // LilyPond twin ties-slurs-breaks.ly writes `\bar "|."` on purpose. The final barline is
  // 0.9 ss of natural width, and this book is read COMPRESSED, so dropping it on one side
  // only changes the force and moves the point (measured: residual 0 -> 0.005535).
  // Lily# stopped stamping a final barline by itself, so this side now says it out loud.
  b'4~ b4 r2 |.
}

section Main {
  melody { ties slurs tieDirection }
}

form main { Main }

score main "ties-slurs" {
  staff melody
}
