// A tuplet in the LOWER voice: its "3" bracket must sit BELOW the triplet (the
// voice's stem side, voice 2 = stems down), anchored to voice 2's own notes —
// not above by the staff-wide "multi-voice => bracket up" rule, and not on the
// primary voice's noteheads. Also guards that voice 2's OWN tuplet still breaks
// its beaming: the triplet beams separately from the following eighths.
// LILYPOND-REF: lily/tuplet-bracket.cc get_default_dir — bracket on the stem side.
octave absolute
title "Lower-voice tuplet"
part mel { clef treble }
section S {
  mel {
    voice { c''4 c'' c'' c'' | }
    voice { tuplet 3/2 { e'8 f' g' } a' b' c'' b' a' g' | }
  }
}
structure { S }
score "multivoice-voice2-tuplet" { staff mel }
