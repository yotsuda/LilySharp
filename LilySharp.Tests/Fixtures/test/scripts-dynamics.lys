// Accent dynamics (sfz family) and the string-player scripts added by the
// 2026-07-02 grammar audit: staccatissimo (direction-flipped wedge),
// up-bow / down-bow (always above), harmonic circle.
part melody { clef treble }

section Main {
  melody {
    c4@sfz d@fp e@sf f@rfz |
    g4@staccatissimo a@staccatissimo b@upbow c@downbow |
    d4@flageolet c@staccatissimo.down b@flageolet a@fz |
    <d, f a>2@fermata <g b d>2@staccato |
    e1@fermata |
    voice { a'4@fermata r2. } voice { c4 d2. } |
  }
}

structure { Main }

score "scripts-dynamics" { staff melody }
