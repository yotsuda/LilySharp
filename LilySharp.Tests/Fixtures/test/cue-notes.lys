// Cue notes example
// Notes marked with @cue are rendered at reduced size (66%)
// LILYPOND-REF: ly/engraver-init.ly CueVoice context — fontSize = #-4

title "Cue Notes Demo"
tempo 120
time 4/4
key c major

part melody
part chords

// Single notes: normal, then cue (each measure: 2 normal + 2 cue)
phrase cueMelody {
  c4 d e@cue f@cue |
  g4 a b@cue c@cue |
}

// Chords: normal then cue
phrase cueChords {
  <c, e g>4 <d f a>4 <e g b>4@cue <f a c>4@cue |
  <c e g>1 |
}

section Main {
  melody { $cueMelody }
  chords { $cueChords }
}

structure { Main }

render score "cue-melody.svg" {
  staff treble { melody }
}

render score "cue-chords.svg" {
  staff treble { chords }
}
