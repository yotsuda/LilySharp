// Courtesy Accidentals Test
// Tests parenthesized accidentals. LilyPond's DEFAULT accidental style does
// NOT add cautionary accidentals across barlines — a pitch altered in one
// measure and returning to the key value in the next shows NOTHING. Only the
// explicit @courtesy annotation forces a parenthesized accidental (≈ LP's `?`).
// Verified against LilyPond 2.24.4.
// LILYPOND-REF: lily/accidental-engraver.cc — default style.

title "Courtesy Accidentals"
composer "Lily#"

tempo 120
time 4/4
key c major

part melody

phrase noAutoCourtesy {
  // cis in measure 1, then c natural in measure 2 — LP shows NO courtesy
  // natural (the accidental is forgotten at the barline).
  c'4 cis d e | c4 d e f |
}

phrase explicitCourtesy {
  // Explicit @courtesy annotation forces parenthesized accidental
  c'4@courtesy d e f |
}

phrase noCourtesy {
  // No courtesy needed: same accidental context
  c'4 d e f | g4 a b c' |
}

phrase noAutoFlatCourtesy {
  // bes in measure 1, then b natural in measure 2 — LP shows NO courtesy.
  c'4 d bes a | b4 c' d e |
}

section Main {
  melody { $noAutoCourtesy $explicitCourtesy $noCourtesy $noAutoFlatCourtesy }
}

structure { Main }

score "courtesy-accidentals" {
  staff { melody }
}
