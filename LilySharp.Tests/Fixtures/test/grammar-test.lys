// 基本文法テスト
title "Grammar Test"
composer "Lily#"

tempo 120
time 4/4
key c major

part melody { clef treble }

phrase intro { d4 e e f | g2 g | }
phrase verse { a4 g f e | d2. r4 | }

section Intro { melody { $intro } }
section Verse { melody { $verse } }
section Chorus { key g major
  melody { g4 a b c | d2 d | }
}

form main {
  Intro
  |: Verse [1. Chorus] :| [2. Intro]
}

score main "grammar-test" { staff melody }
