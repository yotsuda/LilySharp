// Coverage: two voices on one staff (<< { } \\ { } >>) — the upper voice gets
// stems up, the lower voice stems down, and they continue independent relative-
// octave chains. Guards multi-voice stem direction and layout.
title "Two-voice polyphony"
time 4/4
key c major
part m { clef treble }
section Main {
  m {
    << { g'2 a | b4 c b a | } \\ { c4 d e f | g2 g | } >>
  }
}
structure { Main }
score "two-voice-polyphony" { staff { m } }
