// Multi-Voice Test
title "Multi-Voice"
composer "Lily#"

tempo 80
time 4/4

part melody

phrase twoVoices {
  // Two voices: upper (stems up) and lower (stems down)
  voice { c'2 d | e2 f | } { e2 f | g2 a | } 
}

phrase threeVoices {
  // Three voices
  voice { c'2 d } { g2 a } { e2 f }  |
}

section Main {
  melody { twoVoices threeVoices }
}

form main { Main }

score main "multi-voice" {
  staff melody
}
