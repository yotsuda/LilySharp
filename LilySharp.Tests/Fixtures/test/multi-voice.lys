// Multi-Voice Test
title "Multi-Voice"
composer "Lily#"

tempo 80
time 4/4

part melody

phrase twoVoices {
  // Two voices: upper (stems up) and lower (stems down)
  voice { c'2 d | e2 f | } voice { e2 f | g2 a | } 
}

phrase threeVoices {
  // Three voices
  voice { c'2 d } voice { g2 a } voice { e2 f }  |
}

section Main {
  melody { $twoVoices $threeVoices }
}

structure { Main }

score "multi-voice" {
  staff { melody }
}
