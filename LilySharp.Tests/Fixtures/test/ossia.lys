// Ossia staves test — LP-aligned behaviour (NR "Ossia staves"):
// the ossia stacks ABOVE the staff it decorates, prints ONLY over its
// fragment's measures (context exists only for the span), shows no time
// signature, no clef on its first appearance (firstClef = ##f), and shares
// the score-wide spacing columns (only the notation shrinks, magstep -3).
// System 1: fragment on measure 2 only (bare mid-system fragment).
// System 2: the ossia rests throughout and vanishes entirely (hara-kiri).

key g major
time 4/4

section Main {
    melody {
        c4 d e fis | g4 a b c | b4 a g fis |
        break
        c4 d e fis | g2 g | c,1 |
    }
    ossia_melody {
        r1 | c'4 e g e | r1 |
        r1 | r1 | r1 |
    }
}

form main { Main }

score main "ossia" {
    staff melody
    ossia ossia_melody
}
