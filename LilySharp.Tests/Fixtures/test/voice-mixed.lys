// Sequential measures interleaved with a voice { } { } parallel-voice span: the
// single-voice measures BEFORE and AFTER the span must survive (regression
// guard for the bug where a parallel block discarded the surrounding stream).
title "Mixed Voices"
composer "Lily#"
tempo 90
time 4/4
key c major

part m { clef treble }

section Main {
  m {
    c'4 d e f |
    voice { g'2 f } { e2 d }  |
    e'4 d c b |
    a2 g2 |
  }
}

form main { Main }

score main "voice-mixed" {
  staff m
}
