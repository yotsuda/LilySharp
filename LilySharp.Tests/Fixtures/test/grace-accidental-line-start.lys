// A grace before an accidental note/chord at the LINE START must not hang left
// into the clef/key/time. LilyPond gives the grace its own column: the prefix's
// spring ends at that FIRST GRACE column (its accidental in that column's own
// skyline) and is scaled by 0.8, and the run follows in series to the main
// chord, whose accidentals sit in the grace->main gap (LineStartColumn.IntoGraceRun,
// session 832).
octave absolute
key c major

part m { clef treble }

section A {
  m { acciaccatura { cis'8 } <e' ges' bes'>4 r2. }
}

form { A }

score "grace-accidental-line-start" {
  staff m
}
