// A sustain bracket under the LAST staff of system 1 has to clear the trill and the
// fermata standing above the FIRST staff of system 2 (user report, 2026-09-02,
// petite-valse.lys). The bracket was in the staff's own profile but in no arm of the
// PAGING silhouette, so the pair of systems sat on the basic-distance floor and the
// bracket was drawn through the next system's ornaments. Ledger page.pedal-bracket.*
// carries LilyPond's number for the one-staff shape; this is the grand-staff shape.
title "Pedal under the next system"
time 3/4  key a minor  octave absolute

part rh { clef treble }  part lh { clef bass octave 3 }

section A {
  rh { e'4( a' g' | e'2.) | f'4( a' g' | d'2.) | break }
  lh { a,4@sustain <c e a> <c e a> | a,4 <c e a> <c e a>@!sustain |
       d4@sustain <f a d'> <f a d'> | g,4 <b, d g> <b, d g>@!sustain | }
}
section B {
  rh { c''4@trill( b' a' | gis'2.) | e'4( a' g' | a'2.@fermata) | }
  lh { e,4@sustain <gis b d'> <gis b d'> | e,2.@!sustain |
       a,4@sustain <c e a> <c e a> | <a, e a c' e'>2.@!sustain | }
}

form main { A B }

score main "pedal-under-next-system" {
  grandStaff {
    staff rh
    staff lh
  }
}
