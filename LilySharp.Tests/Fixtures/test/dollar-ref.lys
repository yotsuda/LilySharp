// name Phrase Reference Test
// Tests the $ syntax for phrase references
title "Dollar Reference"
composer "Lily#"

tempo 120
time 4/4
key c major

part melody

// Define reusable phrases
phrase motifA { c4 d e f | }
phrase motifB { g4 a b c' | }
phrase motifC { c4 e g c' | }

// Reference phrases with name in sections
section First {
  melody { motifA motifB }
}

section Second {
  melody { motifC motifA }
}

// Reuse sections — the second occurrence of First gets its own display
// label so the printed rehearsal marks stay unique.
form main { First Second First "First (reprise)" }

score main "dollar-ref" {
  staff melody
}
