// Lead sheet idiom: a single melody staff carrying chord symbols (@chord(c:m7))
// above and lyrics below — the "fake book" layout. Exercises chord-name
// routing on a melody staff together with lyric alignment (including the word
// "to", which used to collide with a reserved token and vanish). Authored in
// absolute octave so the register is explicit. Verified against LilyPond.
octave absolute
title "Lead Sheet"
composer "Lily#"

tempo 120
time 4/4
key c major

part melody { clef treble }

section A {
  melody {
    e4@chord(c) e f g | a4@chord(a:m) g e d |
    f4@chord(f) a g f | e4@chord(g:7) d c2 |
  }
  lyrics { Mu- sic fills the | air to- night so | ev- 'ry- one will | sing a- long | }
}

structure { A }

score "lead-sheet" {
  staff melody
}
