// SATB chorale: a four-part hymn texture on a grand staff, with TWO voices on
// EACH staff (soprano/alto on the treble, tenor/bass on the bass) via the
// << v1 \\ v2 >> span. Exercises polyphony on both staves of a grand staff at
// once, per-voice stem directions, and a cadential fermata. Authored in
// absolute octave (each voice sits in its own register) — which only works on
// a multi-part score once the file-level octave mode reaches every staff. The
// lyrics align to the soprano and sit below the whole grand staff. Verified
// against LilyPond.
octave absolute
title "Chorale"
composer "Lily#"

tempo 80
time 4/4
key g major

part upper { clef treble }
part lower { clef bass }

section Main {
  upper {
    << { d'4 d' e' d' | b4 a b2@fermata | }
       \\ { b4 g g fis | g fis g2 } >>
  }
  lower {
    << { g,4 b, c a, | d d d2 | }
       \\ { g,,4 g,, c, d, | g,, d, g,,2 } >>
  }
  lyrics { Praise God from whom | all bless- ings | }
}

structure { Main }

score "chorale" {
  grandStaff {
    staff { upper }
    staff { lower }
  }
}
