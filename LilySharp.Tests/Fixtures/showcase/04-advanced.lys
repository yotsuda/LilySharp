// Showcase 4: Advanced Notation
// Chord names, figured bass, volta, overrides
title "Advanced Notation"
composer "Lily# Showcase"

tempo 120
time 4/4
key c major

part melody

phrase chorale {
  // Chord names above
  <c e g>4@chord(c) <d f a>@chord(d:m) <e g b>@chord(e:m) <f a c'>@chord(f) |
  <g b d'>4@chord(g) <a c' e'>@chord(a:m) <g b d'>@chord(g) <c e g>@chord(c) |
}

phrase figured {
  // Figured bass annotations
  c4@fig(5 3) d@fig(6) e@fig(6 4) f@fig(5 3) |
  g4@fig(7) a@fig(6) g@fig(5 3) c@fig(5 3) |
}

phrase overrideDemo {
  // Grob overrides
  override Stem.length = 10
  c,4 d e f |
  revert Stem.length
  g4 a b c |
}

phrase themeA { c4 d e f | g2. r4 | }
phrase ending1 { e4 f g a | c'1 | }
phrase ending2 { c'4 b a g | c1 | }

section A {
  melody { $chorale $figured $overrideDemo }
}

section B {
  melody { $themeA }
}

section End1 {
  melody { $ending1 }
}

section End2 {
  melody { $ending2 }
}

structure {
  A
  |: B [1. End1] :| [2. End2]
}

score "04-advanced" {
  staff melody
}
