// Showcase 4: Advanced Notation
// Chord names, figured bass, volta
title "Advanced Notation"
composer "Lily# Showcase"

tempo 120
time 4/4
key c major

part melody

phrase chorale {
  // Chord names above
  <c e g>4@chord(C) <d f a>@chord(Dm) <e g b>@chord(Em) <f a c'>@chord(F) |
  <g b d'>4@chord(G) <a c' e'>@chord(Am) <g b d'>@chord(G) <c e g>@chord(C) |
}

phrase figured {
  // Figured bass annotations
  c4@figuredBass(5 3) d@figuredBass(6) e@figuredBass(6 4) f@figuredBass(5 3) |
  g4@figuredBass(7) a@figuredBass(6) g@figuredBass(5 3) c@figuredBass(5 3) |
}

// Was `overrideDemo`, opening with `override Stem.length = 10`. Stem.length is not a
// property the engine reads (LYS1029), so the showcase was demonstrating a no-op.
phrase lowRegister {
  c,4 d e f |
  g4 a b c |
}

phrase themeA { c4 d e f | g2. r4 | }
phrase ending1 { e4 f g a | c'1 | }
phrase ending2 { c'4 b a g | c1 | }

section A {
  melody { chorale figured lowRegister }
}

section B {
  melody { themeA }
}

section End1 {
  melody { ending1 }
}

section End2 {
  melody { ending2 }
}

form {
  A
  |: B [1. End1] :| [2. End2]
}

score "04-advanced" {
  staff melody
}
