// whole-note-tremolo-accidentals.ly score5 twin — 8分 (longa 対・4/1)。
octave absolute
time 4/1

part v { }

section Main {
  v {
    repeat tremolo 16 { c'8 es'8 } |
    repeat tremolo 16 { a'8 cis''8 } |
    repeat tremolo 16 { a'8 gisis'8 } |
    voice { repeat tremolo 16 { a''8 bes''8 } | } { repeat tremolo 16 { f'8 des'8 } | }
  }
}

form { ~Main }

score { staff ~v }
