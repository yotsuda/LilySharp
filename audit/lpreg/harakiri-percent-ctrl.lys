// 陽性対照: percent の代わりに休符なら removeEmpty は system 2 で譜を消す。
// (harakiri-percent.lys の n2 だけ r1 に置換)
octave absolute

part n1 { }
part n2 { }

section Main {
  n1 { c'1 | c' | break c' | c' | }
  n2 { c1 | c | r1 | r1 | }
}

form main { ~Main }

score main { staff ~n1 as removeEmpty true  staff ~n2 as removeEmpty true }
