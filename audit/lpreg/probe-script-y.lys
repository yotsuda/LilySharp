// Twin of probe-script-y.ly (relative anchor c = LP c').
time 4/4

part melody

section A {
  melody {
    c'4@marcato.up c@accent.up c@staccato.up c@trill
    g@marcato.up e@marcato.up c@marcato.up
    c'4@marcato.down e@marcato.down
  }
}

// ~A hides the section label, so the engraved result is unchanged.
form main { ~A }

score main { staff melody }
