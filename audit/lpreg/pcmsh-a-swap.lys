// Control for pcmsh-a-probe.lys: the SAME two parts, declared in the opposite order.
// If the combined staff renders part1's written boundaries verbatim, this flips from
// 8|16|4 to 16|8|4 — which names the combiner, not the run grouping, as what drops
// the other part's boundary. LP is symmetric here (8|8|8|4 either way, since the
// boundaries are the union 0/8/16/24 — scratch/lpreg/pcmsh-a.log).
octave absolute
time 4/4

part vone { clef treble }
part vtwo { clef treble }

section A {
  vone { R1*8 | R1*16 | R1*4 | }
  vtwo { R1*16 | R1*8 | R1*4 | }
}

form main { ~A }

score main { combinedStaff { vtwo vone } }
