// lilypond-src/input/regression/glissando-consecutive.ly の Lily# 訳 (作業 twin)。
// CLAIM: 連続する glissandi が刷られる (前の終点が次の起点)。
// 綴り: \relative 展開 (LP c'=C4 d=D4 e=E4 → Lily# c d e)。
octave absolute
time 4/4

part v { clef treble }

section Main {
  v {
    c'1@glissando | d'1@glissando | e'1 |
  }
}

form { ~Main }

score { staff v }
