// lilypond-src/input/regression/spacing-accidental-rest.ly の Lily# 訳。
// CLAIM: 臨時記号は下にシフトされた rest と衝突しない
// （voice-2 の r8 が voiced 位置に下がり、続く aeses の重臨時記号が左へ届く）。
// 音高: LP 絶対 g'=G4 → g / aeses=A♭♭3 → aeses,。
octave absolute

part melody

section A {
  melody {
    voice { g4 } { r8 aeses,8 } |
  }
}

// ~A hides the section label, so the engraved result is unchanged.
form main { ~A }

score main { staff melody }
