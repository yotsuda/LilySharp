// whole-note-tremolo-accidentals.ly score3 twin — 16分 (breve 対・4/2)。
octave absolute
time 4/2

part v { }

section Main {
  v {
    repeat tremolo 16 { c'16 es'16 } |
    repeat tremolo 16 { a'16 cis''16 } |
    repeat tremolo 16 { a'16 gisis'16 } |
    voice { repeat tremolo 16 { a''16 bes''16 } | } { repeat tremolo 16 { f'16 des'16 } | }
  }
}

form { ~Main }

score { staff ~v }
