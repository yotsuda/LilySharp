// Does the `*N` multiplier already work on a SPACER? (§2D(3) assumes it does not.)
// v2 writes three empty bars as s1*3; the control writes them out as s1 | s1 | s1.
octave absolute
time 4/4

part v { clef treble }

section Main {
  v {
    voice {
      c'1 | d'1 | e'1 | f'1 |
    } {
      s1*3 | c'1 |
    }
  }
}

form { ~Main }

score { staff v }
