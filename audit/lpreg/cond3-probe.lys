// Three bars: is the horizontal residual in the LAST bar, or in every bar after the first?
octave absolute
time 4/4

part fl1 { clef treble }
part fl2 { clef treble }

section A {
  fl1 { c'4 d' e' f' | g'2 g' | c'4 d' e' f' | }
  fl2 { e4 f g a | b2 b | e4 f g a | }
}

form main { ~A }

score main { condensedStaff { fl1 fl2 } }
