// whole-note-tremolo-accidentals.ly score4 twin — 和音 16分 (4/2)。
octave absolute
time 4/2

part v { }

section Main {
  v {
    repeat tremolo 16 { c'16 <es' es''>16 } |
    repeat tremolo 16 { a'16 <f' cis''>16 } |
    repeat tremolo 16 { a'16 <disis' ges''>16 } |
  }
}

form { ~Main }

score { staff ~v }
