// lilypond-src/input/regression/dot-rest-horizontal-spacing.ly の Lily# 訳。
// CLAIM: 付点休符の dot が水平 spacing に正しく算入される——r16. の dot と
// 次の cis'(♯付き)の間が詰まらない。
// 綴り: LP 絶対 cis''=C#5=Lily# cis'。時価は sticky(cis' も 16. を継ぐ)。
time 4/4

part melody

section A {
  melody {
    r16. cis' |
  }
}

// ~A hides the section label, so the engraved result is unchanged.
form main { ~A }

score main { staff melody }
