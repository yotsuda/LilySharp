<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the pictures of a score video: one per playback state, the sounding noteheads lit.
       Run by ../New-ScoreVideo.ps1; not part of LilySharp.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\LilySharp.Lsp\LilySharp.Lsp.csproj" />
    <!-- Core directly too, for SkiaSharp (the pictures are drawn with it; ImageSharp is kept out of
         every output by Directory.Build.props). -->
    <ProjectReference Include="..\..\..\LilySharp.Core\LilySharp.Core.csproj" />
  </ItemGroup>
</Project>
