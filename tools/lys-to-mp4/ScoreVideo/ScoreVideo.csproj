<Project Sdk="Microsoft.NET.Sdk">
  <!-- The pictures of a score video, drawn by LilySharp.Core.Export.ScoreVideo (the editor's
       Export as MP4 Video runs the same) from the language server's playback list.
       Run by ../New-ScoreVideo.ps1; not part of LilySharp.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\LilySharp.Lsp\LilySharp.Lsp.csproj" />
    <!-- Core directly too: ScoreVideo, the parser's UsingExpander and SkiaSharp's natives. -->
    <ProjectReference Include="..\..\..\LilySharp.Core\LilySharp.Core.csproj" />
  </ItemGroup>
</Project>
