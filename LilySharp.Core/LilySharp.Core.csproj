<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>

    <!-- NuGet package metadata -->
    <PackageId>LilySharp.Core</PackageId>
    <Authors>Yoshifumi Tsuda</Authors>
    <Description>Music notation rendering engine inspired by LilyPond. Parses .lys notation files and generates SVG/PDF output with professional engraving quality.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>music;notation;engraving;lilypond;svg;pdf;score</PackageTags>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Generate XML documentation only for Release builds (NuGet pack) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LilySharp.Tests" />
    <InternalsVisibleTo Include="LilySharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="Svg.Skia" Version="3.4.1" />
    <!-- Svg.Skia pulls SkiaSharp with Win32/macOS natives only; Linux
         (CI) needs the native asset package explicitly or every Skia
         call dies with DllNotFoundException: libSkiaSharp. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

  <!-- Include font files as content so they are copied to output -->
  <ItemGroup>
    <Content Include="Fonts\**\*" PackagePath="contentFiles\any\any\fonts;content\fonts" CopyToOutputDirectory="PreserveNewest">
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <!-- Include LICENSE and README in the package -->
  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
