<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>

    <!-- NuGet package metadata -->
    <PackageId>LilySharp.Core</PackageId>
    <Authors>Yoshifumi Tsuda</Authors>
    <Description>Music notation rendering engine inspired by LilyPond. Parses .lys notation files and generates SVG/PDF output with professional engraving quality.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>music;notation;engraving;lilypond;svg;pdf;score</PackageTags>
    <RepositoryType>git</RepositoryType>
    <!-- Where the corresponding source of this package lives (GPL §6). -->
    <RepositoryUrl>https://github.com/yotsuda/LilySharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yotsuda/LilySharp</PackageProjectUrl>
  </PropertyGroup>

  <!-- Generate XML documentation only for Release builds (NuGet pack) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LilySharp.Tests" />
    <InternalsVisibleTo Include="LilySharp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <!-- Skia is referenced DIRECTLY, not through Svg.Skia. Svg.Skia's own
         Svg.Custom is MS-PL: free software, but GPL-incompatible, so it may
         not travel inside a Lily# binary. Nothing here needs it — every
         output format renders from the layout model, and the SVG-string
         rasterizer that did use it lived only in the test harness. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- SkiaSharp ships Win32/macOS natives with the managed package; Linux
         (CI) needs the native asset package explicitly or every Skia
         call dies with DllNotFoundException: libSkiaSharp. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
    <!-- HarfBuzz is the SHAPER LilyPond itself measures text through (Pango calls it),
         and pair kerning cannot be produced without one: SKPaint.MeasureText answers
         per code point and has no notion of a pair. Ledger text.width.{aa,av,8va}
         measured what that costs. Managed binding + the three desktop natives; the
         drawing backends are untouched, this is the measuring path only.
         See TextFontMetrics.Advance. -->
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.3" />
  </ItemGroup>

  <!-- Include font files as content so they are copied to output -->
  <ItemGroup>
    <Content Include="Fonts\**\*" PackagePath="contentFiles\any\any\fonts;content\fonts" CopyToOutputDirectory="PreserveNewest">
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <!-- Include LICENSE and README in the package, plus the notices: this package
       carries the Emmentaler and TeX Gyre fonts and code ported from LilyPond,
       so the terms those come under have to travel with it. -->
  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="..\LILYPOND-ATTRIBUTION.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
