singer Zundamon "neutrino/ZUNDAMON" sings on zunda
singer Metan "neutrino/METAN" sings on metan

// Guitar: chords cut on the off-beats (one bar each), three notes on strings 2-4 at frets 5-10, the roots left to the bass
phrase gBb  { r8 <bes d f>8 r8 q r8 q r8 q | }      // xx876x
phrase gGm  { r8 <bes d g>8 r8 q r8 q r8 q | }      // xx878x
phrase gEb  { r8 <g ees g'>8 r8 q r8 q r8 q | }     // xx588x
phrase gF   { r8 <a c f>8 r8 q r8 q r8 q | }        // xx756x
phrase gD7  { r8 <c' d fis>8 r8 q r8 q r8 q | }     // xx-10-77x
phrase gC7  { r8 <bes c e>8 r8 q r8 q r8 q | }      // xx855x
phrase gEbm { r8 <bes ees ges>8 r8 q r8 q r8 q | }  // xx887x
phrase gCm7 { r8 <bes ees g>8 r8 q r8 q r8 q | }    // xx888x (no root)

// Bass: the root, syncopated (one bar each)
phrase bBb { bes,,4 bes8 bes8 r8 bes8 bes8 bes8 | }
phrase bGm { g,,4 g8 g8 r8 g8 g8 g8 | }
phrase bEb { ees,4 ees8 ees8 r8 ees8 ees8 ees8 | }
phrase bF  { f,4 f8 f8 r8 f8 f8 f8 | }
phrase bD  { d,4 d8 d8 r8 d8 d8 d8 | }
phrase bC  { c,4 c8 c8 r8 c8 c8 c8 | }

// Drums: the closed hi-hat of the verse, the ride of the chorus, the fill
phrase dV {
  voice { hh8 hh hh hh hh hh hh hh | }
  { bd4 sn4 r8 bd8 sn4 | }
}
phrase dC {
  voice { cymr8 cymr cymr cymr cymr cymr cymr cymr | }
  { bd4 sn4 r8 bd8 sn4 | }
}
phrase dF {
  voice { cymr8 cymr cymr cymr cymr cymr cymr cymr | }
  { bd4 sn4 bd8 bd8 sn4 | }
}
phrase dFill {
  voice { sn8 sn tomh tomh tomml tomml toml tomfl | }
  { bd4 r4 r2 | }
}
phrase dHalf {
  voice { hh8 hh hh hh hh hh hh hh | }
  { bd4 r4 sn4 r4 | }
}

