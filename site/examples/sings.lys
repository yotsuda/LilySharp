// A lyrics track holds its words; a score's row prints them under the staff above it.
// ONE set of words can serve several staves: here the same track is placed twice.
time 4/4
key c major
part sop { clef treble }
part alt { clef treble }
section A {
  sop { c''4 c b a | g1 | }
  alt { e'4 e g f | e1 | }
  lyrics verse { Sing- ing a song | now | }
}
form { ~A }
score {
  staff sop "Soprano"
  lyrics verse on sop
  staff alt "Alto"
  lyrics verse on alt
}
