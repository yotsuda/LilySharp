// Lesson 1 of 10 — Let the editor teach you
//
// STEP 0 — SEE THE MUSIC. Press Ctrl+K, release, then press V.
// (Or click the preview icon at the top right of this editor.)
// The score opens beside this file and redraws as you type.
// Click the score, then ▶ to hear it.
//
// Then: Ctrl+Space anywhere lists what you can write there.

title "Mary Had a Little Lamb"
composer "Traditional"

// STEP 1 — Ctrl+Space on the empty line below. Pick `key`, then `g`, then `major`.


part melody {
  // STEP 2 — Ctrl+Space on the empty line below. Pick `instrument`, then `cello`.
  // The bass clef appears by itself. Press ▶.

}

section A {
  // STEP 3 — Type `@` right after the first `e4` below. Pick `mf`.
  melody {
    e4 d c d | e e e2 | d4 d d2 | e4 g g2 |
    e4 d c d | e e e e | d d e d | c1 |
    // STEP 4 — Ctrl+Space on the empty line below. Pick `Cmaj7`: a chord, one more bar.

    |.
  }
}

// STEP 5 — Change the line below to:  form { |: ~A :| }   — now it plays twice.
form { ~A }

score {
  staff melody
}

// MESSAGES — delete one `e` from `e e e2`: a squiggle appears under the bar.
// Rest the mouse on it to read what is wrong. Ctrl+Z puts it back.
//
// NEXT — type `lesson` on a new line and pick `lesson-02-notes`.
